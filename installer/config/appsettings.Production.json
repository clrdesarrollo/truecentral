{
  // Configuración de la instalación como SERVICIO DE WINDOWS (CLRTrueCentralVMS).
  // El instalador reemplaza este archivo en cada actualización: NO lo edite.
  // Para ajustes propios de este equipo (puerto, rutas...) use
  // appsettings.Local.json, que tiene prioridad y nunca es tocado por las
  // actualizaciones.
  // "*" ata IPv4 e IPv6: si solo se atara IPv4 ("0.0.0.0"), los clientes que
  // resuelven "localhost" a ::1 esperarían ~2 s por conexión.
  "Urls": "http://*:5090",
  "Database": {
    // Base PRIVADA del sistema: solo 127.0.0.1 y lejos del 5432 de PostgreSQL
    // (y del 25480 del producto videowall). Si el puerto estuviera ocupado,
    // el instalador anota otro en appsettings.Local.json.
    "PgPort": 25490,
    // Datos fuera de Program Files: sobreviven a actualizaciones y
    // desinstalaciones. Las fotos de patentes y los archivos de las
    // automatizaciones quedan junto a este directorio (anpr\ y workflows\).
    "PgDataDir": "%ProgramData%\\CLRTrueCentralVMS\\pgdata"
  },
  "Hikvision": {
    "SdkLogDirectory": "%ProgramData%\\CLRTrueCentralVMS\\logs\\hcnetsdk"
  },
  "Streaming": {
    // Debe coincidir con el puerto de "Urls": es el que MediaMTX usa para
    // autorizar cada lectura contra este servidor (loopback).
    "ServerPort": 5090
  }
}
