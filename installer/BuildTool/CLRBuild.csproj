<Project Sdk="Microsoft.NET.Sdk">

  <!-- Menú de compilación de instaladores (Terminal.Gui) y modo silencioso
       para automatizar. NO forma parte de la solución ni de los instaladores. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>clrbuild</AssemblyName>
    <RootNamespace>CLRBuild</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="1.19.0" />
  </ItemGroup>

</Project>
