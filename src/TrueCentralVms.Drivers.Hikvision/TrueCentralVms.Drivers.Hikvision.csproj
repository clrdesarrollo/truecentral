<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
    <!-- GB18030: los paneles con firmware chino mandan los nombres en esa
         codificación y .NET no trae las páginas de código heredadas. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- HCNetSDK es nativo de 64 bits: cualquier proceso que cargue este driver debe ser x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
