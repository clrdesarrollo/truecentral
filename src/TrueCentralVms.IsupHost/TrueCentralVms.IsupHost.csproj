<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Servicio ISUP interno: lo lanza y vigila el servidor (no es un servicio de
    Windows aparte). Vive en la misma carpeta que el servidor y carga el SDK
    ISUP de Hikvision desde su subcarpeta isup\, así sus DLL nunca se mezclan
    con las de HCNetSDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- El SDK ISUP es nativo de 64 bits. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TrueCentralVms.IsupHost</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
  </ItemGroup>

  <!-- DLL del SDK ISUP (build\setup-binaries.ps1 las deja en native\hikvision-isup) junto al ejecutable, en isup\. -->
  <ItemGroup>
    <None Include="..\..\native\hikvision-isup\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          LinkBase="isup" TargetPath="isup\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
