<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>CLR TrueCentral VMS — Cliente</AssemblyTitle>
    <ApplicationIcon>Assets\truecentral.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo del producto (compartido con vwcontroller/installer) -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlyleafLib y Flyleaf.FFmpeg van PINEADOS en pareja: el motor valida la
         versión de FFmpeg al arrancar (Engine.Start falla si no calzan). -->
    <PackageReference Include="FlyleafLib" Version="3.11.3" />
    <PackageReference Include="Flyleaf.FFmpeg" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <!-- Captura del micrófono para hablar por los parlantes IP (WaveIn 8 kHz mono). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
