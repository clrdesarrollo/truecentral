<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>CLR TrueCentral VMS — Cliente</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlyleafLib y Flyleaf.FFmpeg van PINEADOS en pareja: el motor valida la
         versión de FFmpeg al arrancar (Engine.Start falla si no calzan). -->
    <PackageReference Include="FlyleafLib" Version="3.11.3" />
    <PackageReference Include="Flyleaf.FFmpeg" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <!-- DPAPI: cifrado de credenciales recordadas, ligado al usuario de Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

</Project>
