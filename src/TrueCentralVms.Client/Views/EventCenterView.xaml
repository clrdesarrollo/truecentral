<UserControl x:Class="TrueCentralVms.Client.Views.EventCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <!-- Centro de eventos: historial de las alertas de las automatizaciones con
         su acuse de recibo. Vive dentro del shell y puede sacarse a una ventana
         aparte (misma vista, mismo ViewModel: la lista es una sola). -->
    <UserControl.Resources>
        <!-- Etiqueta de estado: verde confirmada, roja pendiente, gris informativa. -->
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1D2733"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateLevel}" Value="on">
                    <Setter Property="Background" Value="#12351F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLevel}" Value="off">
                    <Setter Property="Background" Value="#3A1418"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateLevel}" Value="on">
                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLevel}" Value="off">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra: filtro y resumen -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Solo sin confirmar" IsChecked="{Binding OnlyPending}"
                              Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Actualizar" Style="{StaticResource GhostButton}" Command="{Binding LoadCommand}"/>
                    <Button Content="&#xE8A7;  Ventana aparte" FontFamily="Segoe UI" Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}" Command="{Binding PopOutCommand}"
                            ToolTip="Sacar el Centro de eventos a una ventana independiente"
                            Visibility="{Binding IsPoppedOut, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Centro de eventos" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="17" Margin="2,0,12,0" VerticalAlignment="Top"
                                               Foreground="{StaticResource DangerBrush}"/>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="Ver" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                ToolTip="Abrir la ventana de alarma (video, fotos y detalle)"
                                                Command="{Binding DataContext.OpenCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Enterado" Background="{StaticResource DangerBrush}"
                                                Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                FontWeight="SemiBold"
                                                Visibility="{Binding CanAcknowledge, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                Command="{Binding DataContext.AcknowledgeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource StateBadgeText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding RaisedText, Mode=OneWay}"/><Run Text="  ·  "/>
                                            <Run Text="{Binding WorkflowName, Mode=OneWay}"/><Run Text="  ·  "/>
                                            <Run Text="{Binding TriggerSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="Acuse de recibo: "/><Run Text="{Binding AckText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Todavía no hay alertas registradas." FontSize="12.5"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Alerts.Count, Converter={x:Static vm:ZeroToVisibility.Instance}}"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
