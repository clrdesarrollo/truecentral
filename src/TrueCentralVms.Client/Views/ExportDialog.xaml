<Window x:Class="TrueCentralVms.Client.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar grabaciones — CLR TrueCentral VMS"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ShowInTaskbar="False"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Misma receta del shell: sin marco de Windows, franja superior
         arrastrable y ✕ propio. Es MODAL solo para configurar: al aceptar,
         las descargas quedan en el Centro de descargas (no modal). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Barra de título -->
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Width="44" Click="OnCancelClick" ToolTip="Cancelar"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel Orientation="Horizontal" Margin="14,0">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Exportar grabaciones" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pie: cancelar / exportar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Padding="14,6" Content="Cancelar"
                            Click="OnCancelClick"/>
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0"
                            Content="Exportar" Click="OnExportClick"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <StackPanel Margin="18,14,18,16">
            <!-- Error -->
            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="#42201F" CornerRadius="6"
                    Padding="10,7" Margin="0,0,0,12">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           FontSize="11.5" TextWrapping="Wrap"/>
            </Border>

            <!-- Cámara -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Cámara"/>
            <ComboBox x:Name="CameraBox" SelectionChanged="OnAnyInputChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Device.Name, Mode=OneWay}"/>
                            <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Channel.Name, Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Rango: fecha y hora de inicio / fin -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Inicio (fecha y hora)"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FromDateBox" Grid.Column="0" TextChanged="OnAnyInputChanged"
                                 ToolTip="Formato: dd-mm-aaaa"/>
                        <TextBox x:Name="FromTimeBox" Grid.Column="2" TextChanged="OnAnyInputChanged"
                                 ToolTip="Formato: hh:mm:ss (24 horas)"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fin (fecha y hora)"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ToDateBox" Grid.Column="0" TextChanged="OnAnyInputChanged"
                                 ToolTip="Formato: dd-mm-aaaa"/>
                        <TextBox x:Name="ToTimeBox" Grid.Column="2" TextChanged="OnAnyInputChanged"
                                 ToolTip="Formato: hh:mm:ss (24 horas)"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Carpeta destino -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Carpeta de destino" Margin="0,12,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5"
                        Margin="6,0,0,0" Content="…" ToolTip="Elegir carpeta" Click="OnBrowseClick"/>
                <TextBox x:Name="FolderBox" TextChanged="OnAnyInputChanged"/>
            </DockPanel>

            <!-- Formato -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Formato de exportación" Margin="0,12,0,4"/>
            <ComboBox x:Name="FormatBox" SelectionChanged="OnAnyInputChanged">
                <ComboBoxItem Tag="mp4" Content="MP4 — compatible con cualquier reproductor (audio convertido a AAC)"/>
                <ComboBoxItem Tag="mkv" Content="MKV — copia exacta del equipo (video y audio originales)"/>
            </ComboBox>
            <TextBlock Style="{StaticResource FieldHint}"
                       Text="En ambos casos el video se copia tal cual lo grabó el equipo (H.264/HEVC, sin pérdida de calidad). Si el clip es HEVC, use VLC o instale la extensión HEVC de Windows."/>

            <!-- Un archivo o varios -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Archivos" Margin="0,12,0,4"/>
            <StackPanel>
                <RadioButton x:Name="SingleFileRadio" GroupName="split" IsChecked="True"
                             Foreground="{StaticResource TextBrush}" Checked="OnAnyInputChanged"
                             Content="Una sola cápsula de video (tramo de hasta 2 horas)"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton x:Name="SplitRadio" GroupName="split" VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" Checked="OnAnyInputChanged"
                                 Content="Dividir en archivos de"/>
                    <ComboBox x:Name="SplitBox" Width="110" Margin="8,0" SelectionChanged="OnAnyInputChanged">
                        <ComboBoxItem Tag="15" Content="15 minutos"/>
                        <ComboBoxItem Tag="30" Content="30 minutos"/>
                        <ComboBoxItem Tag="60" Content="1 hora"/>
                        <ComboBoxItem Tag="120" Content="2 horas"/>
                    </ComboBox>
                    <TextBlock Text="cada uno" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Cada archivo se descarga por separado en el Centro de descargas, en orden. El nombre de cada uno lleva la fecha y hora de su propio inicio."/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
