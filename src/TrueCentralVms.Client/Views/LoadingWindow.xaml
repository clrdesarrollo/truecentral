<Window x:Class="TrueCentralVms.Client.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!-- Aviso de trabajo en curso (apertura masiva de cámaras). Ventana propia
         y Topmost por el mismo motivo del toast: el video de FlyleafLib vive
         en ventanas superpuestas que taparían un overlay del árbol visual. -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="26,20" Margin="12" MinWidth="320">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="MessageText" Foreground="{StaticResource TextBrush}"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"
                         BorderThickness="0"/>
            <TextBlock Text="Un momento: se están preparando los cuadros de video (Esc para volver)."
                       Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
