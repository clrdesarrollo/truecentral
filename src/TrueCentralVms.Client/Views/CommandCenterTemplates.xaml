<!-- Centro de mando: plantillas de la lista de recursos y de los cuadros que no
     son video (puerta, panel de alarma, cerco, citófono, parlante, módulo de E/S).
     Lo comparten la Vista principal y las pantallas auxiliares. Los colores y
     estilos son los de App.xaml (y del tema Consola). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
                    xmlns:views="clr-namespace:TrueCentralVms.Client.Views">

    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>

    <!-- Color según el nivel del estado (Ok/Armed, Warning/Partial, Alarm, Offline…) -->
    <Style x:Key="LevelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Armed"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Partial"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Offline"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PanelHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Interruptor de una tarjeta (como el Horizontal | Vertical de las divisiones):
         el texto y la perilla que corre; encendido, la pista en el color de acento. -->
    <Style x:Key="CardSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Grid Width="30" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="8" Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource MutedBrush}"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <!-- Ícono de la barra de un cuadro (subdividir, configurar la tarjeta) -->
    <Style x:Key="CellBarIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="6,2">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Lista de recursos ============ -->

    <HierarchicalDataTemplate DataType="{x:Type vm:ResourceGroupNode}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:ResourceNode}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding TreeToolTip}">
            <!-- Las de «Mis páginas» se quitan de la lista con el clic derecho -->
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPersonalWeb}" Value="True">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <MenuItem Header="Quitar de Mis páginas" Command="{Binding RemoveFromListCommand}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Width="14" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Health}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Health}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Health}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}"/>
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Margin="7,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============ Cuadros ============ -->

    <!-- Puerta: estado grande, órdenes y últimos pasos -->
    <DataTemplate DataType="{x:Type vm:DoorCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Style="{StaticResource LevelText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource PanelHint}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource PanelHint}" Margin="0,6,0,10"/>
                <WrapPanel IsEnabled="{Binding CanCommand}">
                    <Button Content="Abrir" Command="{Binding OpenCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Cerrar" Command="{Binding CloseCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Siempre abierta" Command="{Binding RemainOpenCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Siempre cerrada" Command="{Binding RemainLockedCommand}" Style="{StaticResource PanelButton}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ReadOnlyHint}" Style="{StaticResource PanelHint}"/>
                <StackPanel Visibility="{Binding ShowsRecent, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <TextBlock Text="ÚLTIMOS PASOS" Style="{StaticResource PanelSection}"/>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="62"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding What}" Width="104" FontSize="12"
                                               Style="{StaticResource LevelText}"/>
                                    <TextBlock Text="{Binding Who}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Panel de alarma: cada área con armar total/parcial, desarmar y silenciar -->
    <DataTemplate DataType="{x:Type vm:AlarmCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding Item.StatusText}" Style="{StaticResource PanelHint}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Item.Areas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Style="{StaticResource LevelText}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ArmLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <!-- Con el panel sin conexión no hay órdenes que mandar -->
                                    <WrapPanel Margin="26,6,0,0"
                                               IsEnabled="{Binding DataContext.Item.IsOnline, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Button Content="Armar total" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanArmAway}"
                                                Command="{Binding DataContext.ArmAwayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Armar parcial" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanArmStay}"
                                                Command="{Binding DataContext.ArmStayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Desarmar" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanDisarm}"
                                                Command="{Binding DataContext.DisarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Silenciar" Style="{StaticResource PanelButton}"
                                                Visibility="{Binding InAlarm, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                Command="{Binding DataContext.ClearAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Item.ReadOnlyHint}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Cerco eléctrico: estado y las órdenes del módulo Cerco -->
    <DataTemplate DataType="{x:Type vm:CercoCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12" DataContext="{Binding}">
                <StackPanel Orientation="Horizontal" DataContext="{Binding Item}">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0"
                               VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        <TextBlock Style="{StaticResource PanelHint}">
                            <Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Armar" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanArm}"
                            Command="{Binding Cerco.ArmCommand}" CommandParameter="{Binding Item}"/>
                    <Button Content="Desarmar" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanDisarm}"
                            Command="{Binding Cerco.DisarmCommand}" CommandParameter="{Binding Item}"/>
                    <Button Content="Silenciar sirena" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanSilence}"
                            Command="{Binding Cerco.SilenceCommand}" CommandParameter="{Binding Item}"/>
                </WrapPanel>
                <!-- El aviso del cerco siempre trae texto: se muestra solo si no se puede operar -->
                <TextBlock Text="{Binding Item.ReadOnlyHint}" Style="{StaticResource PanelHint}"
                           Visibility="{Binding Item.IsReadOnly, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Citófono: estado, llamada y contestar / abrir la puerta -->
    <DataTemplate DataType="{x:Type vm:IntercomCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Item.IsRinging}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.StatusText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Item.CallText}" Style="{StaticResource PanelHint}"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Contestar / ver el frente" Style="{StaticResource PanelButton}" Command="{Binding AnswerCommand}"/>
                    <Button Content="Abrir la puerta" Style="{StaticResource PanelButton}" Command="{Binding OpenDoorCommand}"
                            IsEnabled="{Binding Item.CanOperate}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Parlante: estado y hablar por él -->
    <DataTemplate DataType="{x:Type vm:SpeakerCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.Tooltip}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{Binding TalkLabel}" Style="{StaticResource PanelButton}" Command="{Binding ToggleTalkCommand}"
                            IsEnabled="{Binding Item.CanOperate}"/>
                </WrapPanel>
                <TextBlock Text="Habla con el micrófono elegido en el panel de parlantes." Style="{StaticResource PanelHint}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Grupo de parlantes: hablar a todos, hacerlos sonar o detener; integrantes con su estado -->
    <DataTemplate DataType="{x:Type vm:SpeakerGroupCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOperate}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{Binding TalkLabel}" Style="{StaticResource PanelButton}" Command="{Binding ToggleTalkCommand}"
                            IsEnabled="{Binding CanOperate}"/>
                    <Button Content="Detener" Style="{StaticResource PanelButton}" Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanOperate}" ToolTip="Detiene lo que esté sonando en los parlantes del grupo"/>
                </WrapPanel>
                <DockPanel Margin="0,2,0,0" IsEnabled="{Binding CanOperate}"
                           Visibility="{Binding Speakers.HasSounds, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <Button DockPanel.Dock="Right" Content="Reproducir" Style="{StaticResource PanelButton}" Margin="6,0,0,0"
                            Command="{Binding PlaySoundCommand}" ToolTip="Hace sonar el sonido en todo el grupo, sincronizado"/>
                    <!-- El estilo oscuro no usa DisplayMemberPath: el nombre va en la plantilla -->
                    <ComboBox ItemsSource="{Binding Speakers.ServerSounds}" SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}" Height="28" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Habla con el micrófono elegido en el panel de parlantes." Style="{StaticResource PanelHint}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
                <TextBlock Text="PARLANTES" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding BusyWith}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Módulo de E/S: salidas (relés) con encender/apagar/pulso y entradas -->
    <DataTemplate DataType="{x:Type vm:IoCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource PanelHint}"/>
                <TextBlock Text="SALIDAS" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Outputs}" IsEnabled="{Binding MayOperate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Encender" Command="{Binding OnCommand}" Style="{StaticResource PanelButton}" Margin="0,0,4,0"/>
                                    <Button Content="Apagar" Command="{Binding OffCommand}" Style="{StaticResource PanelButton}" Margin="0,0,4,0"/>
                                    <Button Content="Pulso" Command="{Binding PulseCommand}" Style="{StaticResource PanelButton}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Code}" Width="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateText}" Width="70" VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="ENTRADAS" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="{Binding Code}" Width="44" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding StateText}" Width="70" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Tarjetas de reporte ============ -->

    <!-- Rótulos de los medidores de la tarjeta Servidor -->
    <Style x:Key="GaugeLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GaugeSub" TargetType="TextBlock" BasedOn="{StaticResource PanelHint}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,1,2,0"/>
    </Style>
    <!-- Salida de red: el violeta del panel web -->
    <SolidColorBrush x:Key="NetOutBrush" Color="#A48BFF"/>

    <!-- Estado de los equipos: primero la lista de tipos, después cuántos están sin
         conexión, la hora de la lectura y al final el detalle de los caídos. -->
    <DataTemplate DataType="{x:Type vm:EquipmentCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Width="22" VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource PanelHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="SIN CONEXIÓN" Style="{StaticResource PanelSection}"
                           Visibility="{Binding Offline.Count, Converter={x:Static vm:CountToVisibility.Instance}}"/>
                <ItemsControl ItemsSource="{Binding Offline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource PanelHint}">
                                    <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Since, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Servidor -->
    <DataTemplate DataType="{x:Type vm:ServerCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource PanelHint}" Margin="0,0,0,10"/>
                <!-- Throughput: medidor de aguja + entrada / salida y la curva de los últimos minutos -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12"
                        Visibility="{Binding HasNetwork, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="190"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <views:ThroughputGauge Value="{Binding NetMbps}" Maximum="{Binding NetScale}" Level="{Binding NetLevel}"/>
                            <TextBlock Text="THROUGHPUT" Style="{StaticResource GaugeLabel}" Margin="0,-4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <DockPanel Margin="0,0,0,6">
                                <Grid DockPanel.Dock="Left" Width="22" Height="22">
                                    <Border CornerRadius="6" Background="{StaticResource AccentBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RxText}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Entrada" Foreground="{StaticResource MutedBrush}" Margin="8,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="22" Height="22">
                                    <Border CornerRadius="6" Background="{StaticResource NetOutBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource NetOutBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TxText}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Salida" Foreground="{StaticResource MutedBrush}" Margin="8,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <views:Sparkline Values="{Binding NetHistory}" Height="38" Margin="0,8,0,6"/>
                            <TextBlock Text="{Binding PeakText}" Style="{StaticResource PanelHint}"/>
                            <TextBlock Text="{Binding LinkText}" Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- CPU, memoria y disco -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel>
                        <views:PercentGauge Value="{Binding Cpu}" MaxWidth="128"/>
                        <TextBlock Text="CPU" Style="{StaticResource GaugeLabel}" Margin="0,4,0,0"/>
                        <TextBlock Text="procesador" Style="{StaticResource GaugeSub}"/>
                    </StackPanel>
                    <StackPanel>
                        <views:PercentGauge Value="{Binding Ram}" MaxWidth="128"/>
                        <TextBlock Text="MEMORIA" Style="{StaticResource GaugeLabel}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource GaugeSub}"/>
                    </StackPanel>
                    <StackPanel>
                        <views:PercentGauge Value="{Binding Disk}" MaxWidth="128"/>
                        <TextBlock Text="DISCO" Style="{StaticResource GaugeLabel}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource GaugeSub}"/>
                    </StackPanel>
                </UniformGrid>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                <!-- Clientes conectados ahora: escritorio (con el cupo de la licencia) y panel web -->
                <DockPanel Margin="0,0,0,10" Visibility="{Binding HasClients, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="{StaticResource AccentBrush}" Opacity="0.15"/>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ClientsText}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CLIENTES CONECTADOS" Style="{StaticResource GaugeLabel}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ClientsDetail}" Style="{StaticResource PanelHint}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding ServicesText}" FontWeight="SemiBold" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Problems}" Style="{StaticResource PanelHint}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Últimas alertas, con el diseño de la pantalla de alarma de las casetas (la
         Raspberry, monitor en pie): arriba el detalle de la elegida —prioridad, qué
         pasó, de dónde, la foto y el botón para confirmarla—; abajo la lista, cada
         alerta con la barra de color de su prioridad y si sigue sin confirmar. -->
    <DataTemplate DataType="{x:Type vm:AlertsCardPanel}">
        <Grid Background="{StaticResource CellBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150"/>
                <RowDefinition Height="2*" MinHeight="80"/>
            </Grid.RowDefinitions>
            <!-- Detalle de la alerta elegida -->
            <Border Margin="8,8,8,4" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="12,10,12,8">
                <Grid>
                    <!-- Sin alertas: en espera, se lee de un vistazo -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <TextBlock Text="✓" FontSize="40" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sin alarmas pendientes" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Esperando nuevos eventos" Style="{StaticResource PanelHint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <!-- Compacto, para que en un card chico igual queden a la vista la foto y el botón:
                         una línea por dato y lo que no cabe se corta con puntos suspensivos. -->
                    <Grid Visibility="{Binding Selected, Converter={x:Static vm:NotNullToVisibility.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <!-- Cuántas faltan, como la píldora roja del encabezado de la caseta -->
                            <Border DockPanel.Dock="Right" Background="#B71C1C" CornerRadius="10" Padding="9,1"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding PendingCount, Converter={x:Static vm:CountToVisibility.Instance}}">
                                <TextBlock Text="{Binding PendingText}" Foreground="White" FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                            <Border DockPanel.Dock="Left" Background="{Binding Selected.PriorityBrush}" CornerRadius="3" Padding="7,1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Selected.PriorityText}" Foreground="White" FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                            <TextBlock Text="{Binding Selected.Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Selected.Title}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource PanelHint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding Selected.Origin}">
                            <Run Text="{Binding Selected.Source, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/><Run Text="  ·  "/><Run Text="{Binding Selected.DateText, Mode=OneWay}"/>
                        </TextBlock>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding Selected.Message}" Style="{StaticResource PanelHint}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Message}"
                                       Visibility="{Binding Selected.HasMessage, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                            <!-- Consignas de la ficha del recurso: qué tiene que hacer el operador -->
                            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4"
                                    Padding="8,3" Margin="0,5,0,0"
                                    Visibility="{Binding Selected.HasInstructions, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="34"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.Instructions}">
                                    <Run Text="QUÉ HACER  " FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding Selected.Instructions, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <!-- La foto de la alarma: lo que se mira de lejos -->
                        <Border Grid.Row="3" Margin="0,6" Background="#000000" CornerRadius="4" MinHeight="30" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="Esta alarma no trae imagen" Style="{StaticResource PanelHint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <Binding Path="SelectedImage" Converter="{x:Static vm:NullToVisibility.Instance}"/>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <Image Source="{Binding SelectedImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <!-- Pendiente: CONFIRMAR (como «Marcar como vista» en la caseta). Atendida: quién y cuándo.
                             Siempre, la ventana de alarma con sus cámaras en vivo. -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" Padding="10,5" FontWeight="SemiBold"
                                    Content="CONFIRMAR" Command="{Binding AcknowledgeCommand}" CommandParameter="{Binding Selected}"
                                    Visibility="{Binding Selected.IsPending, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                    ToolTip="Darse por enterado de la alerta (queda a su nombre en el Centro de eventos)"/>
                            <TextBlock Text="{Binding Selected.AckText}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource OkBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Selected.AckText}"
                                       Visibility="{Binding Selected.IsPending, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,5" Margin="6,0,0,0"
                                    Content="Ver alarma" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}"
                                    ToolTip="Abrir la ventana de alarma con las cámaras vinculadas en vivo"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <!-- La lista: la elegida se marca con el filo de acento. Encima, el interruptor
                 que deja solo las que faltan por confirmar. -->
            <DockPanel Grid.Row="1">
                <ToggleButton DockPanel.Dock="Top" Style="{StaticResource CardSwitch}" HorizontalAlignment="Right"
                              Margin="0,2,14,2" Content="Solo sin confirmar" IsChecked="{Binding PendingOnly}"
                              ToolTip="Mostrar en la lista solo las alertas que faltan por confirmar"/>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="6,2,6,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel Opacity="{Binding CardOpacity}">
                                    <Rectangle DockPanel.Dock="Left" Width="4" Fill="{Binding PriorityBrush}"/>
                                    <StackPanel Margin="9,5,6,5">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource PanelHint}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Time}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PriorityText}" FontSize="10.5" FontWeight="Bold" Margin="8,0,0,0"
                                                       Foreground="{Binding PriorityBrush}" VerticalAlignment="Center"/>
                                            <Border Background="#B71C1C" CornerRadius="7" Padding="6,0" Margin="8,0,0,0"
                                                    Visibility="{Binding IsPending, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                                <TextBlock Text="SIN CONFIRMAR" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="✓ confirmada" FontSize="11" Foreground="{StaticResource OkBrush}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Acknowledged, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="10,0,10,6"
                       VerticalAlignment="Bottom"
                       Visibility="{Binding Status, Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
        </Grid>
    </DataTemplate>

    <!-- Últimas patentes: escena y recorte de la lectura elegida a la izquierda, la lista (angosta) a la derecha.
         La escena va a su tamaño natural, con tope para que debajo siempre quepan el recorte, la patente y el pie (150);
         el alto que sobra es para el recorte y la patente, centrados. -->
    <DataTemplate DataType="{x:Type vm:PlatesCardPanel}">
        <Grid Background="{StaticResource CellBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <!-- Abajo, de lado a lado (también bajo la lista), cuándo y dónde se leyó la elegida -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PlatesLeft" Margin="10,10,6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#000000" CornerRadius="3"
                        MaxHeight="{Binding ActualHeight, ElementName=PlatesLeft, Converter={x:Static vm:Minus.Instance}, ConverterParameter=150}">
                    <Grid>
                        <Image Source="{Binding SceneImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Sin imagen de la escena" Style="{StaticResource PanelHint}" Margin="0,50"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="SceneImage" Converter="{x:Static vm:NullToVisibility.Instance}"/>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Border>
                <!-- El recorte crece con el alto que deja la escena (de 72 a 130) y la patente leída va debajo -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding PlateImage}" MinHeight="72" MaxHeight="130" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- La patente leída bajo el recorte, como en la página ANPR: verde sobre negro, roja si no es una PPU chilena válida -->
                    <Border Grid.Row="1" Background="#000000" CornerRadius="4" Padding="16,2" Margin="0,6,0,0" HorizontalAlignment="Center"
                            ToolTip="{Binding Selected.PlateHint}"
                            Visibility="{Binding Selected, Converter={x:Static vm:NotNullToVisibility.Instance}}">
                        <TextBlock Text="{Binding Selected.Plate}" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource MonoFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#39FF14"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.InvalidChile}" Value="True">
                                            <Setter Property="Foreground" Value="#FF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="10,4">
                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource PanelHint}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Border>
            <ListBox Grid.Column="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrush}"
                     Padding="6,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Width="64" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"/>
                                <Border Background="#F2F2F2" CornerRadius="3" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Plate}" Foreground="#111111" FontWeight="Bold" FontSize="14"
                                               FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Where}" Style="{StaticResource PanelHint}" Margin="64,1,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DataTemplate>

    <!-- Últimos accesos -->
    <!-- Últimos accesos, con el diseño de la tarjeta de alertas: arriba quién pasó
         —el resultado, su nombre, la puerta y la hora, su área, cargo y con qué se
         identificó, y su foto del padrón—; abajo la lista, cada paso con la barra
         de color de su resultado (lo que no es un paso de alguien, apagado). -->
    <DataTemplate DataType="{x:Type vm:AccessCardPanel}">
        <Grid Background="{StaticResource CellBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150"/>
                <RowDefinition Height="2*" MinHeight="80"/>
            </Grid.RowDefinitions>
            <!-- Detalle del paso elegido -->
            <Border Margin="8,8,8,4" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="12,10,12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sin accesos recientes" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Esperando nuevos eventos" Style="{StaticResource PanelHint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Visibility="{Binding Selected, Converter={x:Static vm:NotNullToVisibility.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="{Binding Selected.ResultBrush}" CornerRadius="3" Padding="7,1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Selected.ResultText}" Foreground="White" FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                            <!-- Las cámaras de la puerta, en la ventana de verificación -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="11"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenLiveCommand}"
                                    ToolTip="Abrir las cámaras de esta puerta en vivo"
                                    Visibility="{Binding CanOpenLive, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ver en vivo" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Selected.Who}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Selected.Who}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource PanelHint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding Selected.Door}">
                            <Run Text="{Binding Selected.Door, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/><Run Text="  ·  "/><Run Text="{Binding Selected.DateText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Text="{Binding Selected.Detail}" Style="{StaticResource PanelHint}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Detail}"
                                   Visibility="{Binding Selected.HasDetail, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                        <!-- Lo que se mira de lejos: la foto del momento del paso al lado de la del
                             padrón, cada una con su pie (de dónde salió y cuándo). -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#000000" CornerRadius="4" MinHeight="30" ClipToBounds="True">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding Selected.HasPhoto, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Selected.PhotoText}" Style="{StaticResource PanelHint}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Image Source="{Binding SelectedPhoto}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="8,3"
                                            Visibility="{Binding Selected.HasPhoto, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                        <TextBlock Text="{Binding Selected.PhotoText}" FontSize="11" Foreground="White"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.PhotoText}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#000000" CornerRadius="4" MinHeight="30" ClipToBounds="True">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding Selected.HasFace, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Selected.NoFaceText}" Style="{StaticResource PanelHint}"
                                                   HorizontalAlignment="Center" Margin="4,6,4,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                    <Image Source="{Binding SelectedFace}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="8,3"
                                            Visibility="{Binding Selected.HasFace, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                        <TextBlock Text="Padrón" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <!-- La lista: el elegido se marca con el filo de acento. Encima, el interruptor
                 que suma los eventos del sistema (la puesta en hora, la cerradura…). -->
            <DockPanel Grid.Row="1">
                <ToggleButton DockPanel.Dock="Top" Style="{StaticResource CardSwitch}" HorizontalAlignment="Right"
                              Margin="0,2,14,2" Content="Eventos del sistema" IsChecked="{Binding IncludeSystem}"
                              ToolTip="Mostrar también la puesta en hora, los avisos del equipo y la cerradura y el sensor de la puerta"/>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="6,2,6,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" ClipToBounds="True" Background="{StaticResource Panel2Brush}">
                                <DockPanel Opacity="{Binding CardOpacity}">
                                    <Rectangle DockPanel.Dock="Left" Width="4" Fill="{Binding ResultBrush}"/>
                                    <StackPanel Margin="9,5,6,5">
                                        <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Door}" Style="{StaticResource PanelHint}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Time}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ResultText}" FontSize="10.5" FontWeight="Bold" Margin="8,0,0,0"
                                                       Foreground="{Binding ResultBrush}" VerticalAlignment="Center"/>
                                            <!-- Tiene foto del momento -->
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="8,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                       ToolTip="{Binding PhotoText}"
                                                       Visibility="{Binding HasPhoto, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="10,0,10,6"
                       VerticalAlignment="Bottom"
                       Visibility="{Binding Status, Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
        </Grid>
    </DataTemplate>
    <!-- Página web: el navegador del cuadro y, abajo, dónde está, el zoom y Recargar -->
    <DataTemplate DataType="{x:Type vm:WebCellPanel}">
        <DockPanel Background="{StaticResource CellBgBrush}">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="8,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,1" FontSize="11"
                            Command="{Binding ReloadCommand}" ToolTip="Volver a cargar la página">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Recargar" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Zoom de la página (también Ctrl + rueda); se guarda con el cuadro -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource GhostButton}" Padding="7,1" FontSize="11"
                                Command="{Binding ZoomOutCommand}" ToolTip="Alejar (también Ctrl + rueda en la página)">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="6,1" FontSize="11" MinWidth="48"
                                Content="{Binding ZoomLabel}" Command="{Binding ZoomResetCommand}"
                                ToolTip="Zoom de la página: clic para volver a 100 %"/>
                        <Button Style="{StaticResource GhostButton}" Padding="7,1" FontSize="11"
                                Command="{Binding ZoomInCommand}" ToolTip="Acercar (también Ctrl + rueda en la página)">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentUrl}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentUrl}"/>
                </DockPanel>
            </Border>
            <!-- Modo Unir de la grilla (Vista en vivo o pantalla auxiliar): la página se esconde -->
            <views:WebCellView MergeMode="{Binding DataContext.IsMergeMode,
                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
