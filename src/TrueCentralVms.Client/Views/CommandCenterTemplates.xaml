<!-- Centro de mando: plantillas de la lista de recursos y de los cuadros que no
     son video (puerta, panel de alarma, cerco, citófono, parlante, módulo de E/S).
     Lo comparten la Vista principal y las pantallas auxiliares. Los colores y
     estilos son los de App.xaml (y del tema Consola). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
                    xmlns:views="clr-namespace:TrueCentralVms.Client.Views">

    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>

    <!-- Color según el nivel del estado (Ok/Armed, Warning/Partial, Alarm, Offline…) -->
    <Style x:Key="LevelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Armed"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Partial"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Offline"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Unknown"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PanelHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PanelSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <!-- ============ Lista de recursos ============ -->

    <HierarchicalDataTemplate DataType="{x:Type vm:ResourceGroupNode}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:ResourceNode}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding TreeToolTip}">
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Width="14" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Health}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Health}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Health}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}"/>
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Margin="7,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============ Cuadros ============ -->

    <!-- Puerta: estado grande, órdenes y últimos pasos -->
    <DataTemplate DataType="{x:Type vm:DoorCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Style="{StaticResource LevelText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource PanelHint}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource PanelHint}" Margin="0,6,0,10"/>
                <WrapPanel IsEnabled="{Binding CanCommand}">
                    <Button Content="Abrir" Command="{Binding OpenCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Cerrar" Command="{Binding CloseCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Siempre abierta" Command="{Binding RemainOpenCommand}" Style="{StaticResource PanelButton}"/>
                    <Button Content="Siempre cerrada" Command="{Binding RemainLockedCommand}" Style="{StaticResource PanelButton}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ReadOnlyHint}" Style="{StaticResource PanelHint}"/>
                <StackPanel Visibility="{Binding ShowsRecent, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <TextBlock Text="ÚLTIMOS PASOS" Style="{StaticResource PanelSection}"/>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="62"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding What}" Width="104" FontSize="12"
                                               Style="{StaticResource LevelText}"/>
                                    <TextBlock Text="{Binding Who}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Panel de alarma: cada área con armar total/parcial, desarmar y silenciar -->
    <DataTemplate DataType="{x:Type vm:AlarmCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding Item.StatusText}" Style="{StaticResource PanelHint}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Item.Areas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Style="{StaticResource LevelText}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ArmLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <!-- Con el panel sin conexión no hay órdenes que mandar -->
                                    <WrapPanel Margin="26,6,0,0"
                                               IsEnabled="{Binding DataContext.Item.IsOnline, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Button Content="Armar total" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanArmAway}"
                                                Command="{Binding DataContext.ArmAwayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Armar parcial" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanArmStay}"
                                                Command="{Binding DataContext.ArmStayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Desarmar" Style="{StaticResource PanelButton}" IsEnabled="{Binding CanDisarm}"
                                                Command="{Binding DataContext.DisarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Silenciar" Style="{StaticResource PanelButton}"
                                                Visibility="{Binding InAlarm, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                Command="{Binding DataContext.ClearAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Item.ReadOnlyHint}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Cerco eléctrico: estado y las órdenes del módulo Cerco -->
    <DataTemplate DataType="{x:Type vm:CercoCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12" DataContext="{Binding}">
                <StackPanel Orientation="Horizontal" DataContext="{Binding Item}">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0"
                               VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        <TextBlock Style="{StaticResource PanelHint}">
                            <Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Armar" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanArm}"
                            Command="{Binding Cerco.ArmCommand}" CommandParameter="{Binding Item}"/>
                    <Button Content="Desarmar" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanDisarm}"
                            Command="{Binding Cerco.DisarmCommand}" CommandParameter="{Binding Item}"/>
                    <Button Content="Silenciar sirena" Style="{StaticResource PanelButton}" IsEnabled="{Binding Item.CanSilence}"
                            Command="{Binding Cerco.SilenceCommand}" CommandParameter="{Binding Item}"/>
                </WrapPanel>
                <!-- El aviso del cerco siempre trae texto: se muestra solo si no se puede operar -->
                <TextBlock Text="{Binding Item.ReadOnlyHint}" Style="{StaticResource PanelHint}"
                           Visibility="{Binding Item.IsReadOnly, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Citófono: estado, llamada y contestar / abrir la puerta -->
    <DataTemplate DataType="{x:Type vm:IntercomCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Item.IsRinging}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.StatusText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Item.CallText}" Style="{StaticResource PanelHint}"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Contestar / ver el frente" Style="{StaticResource PanelButton}" Command="{Binding AnswerCommand}"/>
                    <Button Content="Abrir la puerta" Style="{StaticResource PanelButton}" Command="{Binding OpenDoorCommand}"
                            IsEnabled="{Binding Item.CanOperate}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Parlante: estado y hablar por él -->
    <DataTemplate DataType="{x:Type vm:SpeakerCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.Tooltip}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{Binding TalkLabel}" Style="{StaticResource PanelButton}" Command="{Binding ToggleTalkCommand}"
                            IsEnabled="{Binding Item.CanOperate}"/>
                </WrapPanel>
                <TextBlock Text="Habla con el micrófono elegido en el panel de parlantes." Style="{StaticResource PanelHint}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Grupo de parlantes: hablar a todos, hacerlos sonar o detener; integrantes con su estado -->
    <DataTemplate DataType="{x:Type vm:SpeakerGroupCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOperate}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTalking}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{Binding TalkLabel}" Style="{StaticResource PanelButton}" Command="{Binding ToggleTalkCommand}"
                            IsEnabled="{Binding CanOperate}"/>
                    <Button Content="Detener" Style="{StaticResource PanelButton}" Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanOperate}" ToolTip="Detiene lo que esté sonando en los parlantes del grupo"/>
                </WrapPanel>
                <DockPanel Margin="0,2,0,0" IsEnabled="{Binding CanOperate}"
                           Visibility="{Binding Speakers.HasSounds, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <Button DockPanel.Dock="Right" Content="Reproducir" Style="{StaticResource PanelButton}" Margin="6,0,0,0"
                            Command="{Binding PlaySoundCommand}" ToolTip="Hace sonar el sonido en todo el grupo, sincronizado"/>
                    <!-- El estilo oscuro no usa DisplayMemberPath: el nombre va en la plantilla -->
                    <ComboBox ItemsSource="{Binding Speakers.ServerSounds}" SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}" Height="28" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Habla con el micrófono elegido en el panel de parlantes." Style="{StaticResource PanelHint}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
                <TextBlock Text="PARLANTES" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding BusyWith}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Módulo de E/S: salidas (relés) con encender/apagar/pulso y entradas -->
    <DataTemplate DataType="{x:Type vm:IoCellPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource PanelHint}"/>
                <TextBlock Text="SALIDAS" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Outputs}" IsEnabled="{Binding MayOperate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Encender" Command="{Binding OnCommand}" Style="{StaticResource PanelButton}" Margin="0,0,4,0"/>
                                    <Button Content="Apagar" Command="{Binding OffCommand}" Style="{StaticResource PanelButton}" Margin="0,0,4,0"/>
                                    <Button Content="Pulso" Command="{Binding PulseCommand}" Style="{StaticResource PanelButton}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Code}" Width="44" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateText}" Width="70" VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="ENTRADAS" Style="{StaticResource PanelSection}"/>
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="{Binding Code}" Width="44" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding StateText}" Width="70" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Tarjetas de reporte ============ -->

    <Style x:Key="CardBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Margin" Value="0,3,0,8"/>
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Estado de los equipos -->
    <DataTemplate DataType="{x:Type vm:EquipmentCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource PanelHint}" Margin="0,2,0,8"/>
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Width="22" VerticalAlignment="Center" Style="{StaticResource LevelText}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" Style="{StaticResource LevelText}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="SIN CONEXIÓN" Style="{StaticResource PanelSection}"
                           Visibility="{Binding Offline.Count, Converter={x:Static vm:CountToVisibility.Instance}}"/>
                <ItemsControl ItemsSource="{Binding Offline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource PanelHint}">
                                    <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Since, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Servidor -->
    <DataTemplate DataType="{x:Type vm:ServerCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource PanelHint}" Margin="0,0,0,10"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding Cpu, Mode=OneWay}" Style="{StaticResource CardBar}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Memoria" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding Ram, Mode=OneWay}" Style="{StaticResource CardBar}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Disco" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding Disk, Mode=OneWay}" Style="{StaticResource CardBar}"/>
                <TextBlock Text="{Binding ServicesText}" FontWeight="SemiBold" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ServicesLevel}" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Problems}" Style="{StaticResource PanelHint}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Últimas alertas -->
    <DataTemplate DataType="{x:Type vm:AlertsCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <StackPanel Margin="14,12">
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ver" Style="{StaticResource PanelButton}" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Style="{StaticResource LevelText}"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource PanelHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding Time, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Últimas patentes: escena y recorte de la lectura elegida a la izquierda, la lista a la derecha -->
    <DataTemplate DataType="{x:Type vm:PlatesCardPanel}">
        <Grid Background="{StaticResource CellBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="250"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="10,10,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#000000" CornerRadius="3">
                    <Grid>
                        <Image Source="{Binding SceneImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Sin imagen de la escena" Style="{StaticResource PanelHint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="SceneImage" Converter="{x:Static vm:NullToVisibility.Instance}"/>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Border>
                <Image Grid.Row="1" Source="{Binding PlateImage}" Height="64" Stretch="Uniform" HorizontalAlignment="Left"
                       Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Row="2" Text="{Binding SelectedText}" Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Grid>
            <ListBox Grid.Column="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrush}"
                     Padding="6,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Width="64" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"/>
                                <Border Background="#F2F2F2" CornerRadius="3" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Plate}" Foreground="#111111" FontWeight="Bold" FontSize="14"
                                               FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Where}" Style="{StaticResource PanelHint}" Margin="64,1,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DataTemplate>

    <!-- Últimos accesos -->
    <DataTemplate DataType="{x:Type vm:AccessCardPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CellBgBrush}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="14,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64"
                                               Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding What}" Style="{StaticResource LevelText}"/>
                                    <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Door}" Style="{StaticResource PanelHint}" Margin="64,0,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>
    <!-- Página web: el navegador del cuadro y, abajo, dónde está, el zoom y Recargar -->
    <DataTemplate DataType="{x:Type vm:WebCellPanel}">
        <DockPanel Background="{StaticResource CellBgBrush}">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="8,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,1" FontSize="11"
                            Command="{Binding ReloadCommand}" ToolTip="Volver a cargar la página">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Recargar" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Zoom de la página (también Ctrl + rueda); se guarda con el cuadro -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource GhostButton}" Padding="7,1" FontSize="11"
                                Command="{Binding ZoomOutCommand}" ToolTip="Alejar (también Ctrl + rueda en la página)">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="6,1" FontSize="11" MinWidth="48"
                                Content="{Binding ZoomLabel}" Command="{Binding ZoomResetCommand}"
                                ToolTip="Zoom de la página: clic para volver a 100 %"/>
                        <Button Style="{StaticResource GhostButton}" Padding="7,1" FontSize="11"
                                Command="{Binding ZoomInCommand}" ToolTip="Acercar (también Ctrl + rueda en la página)">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentUrl}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentUrl}"/>
                </DockPanel>
            </Border>
            <!-- Modo Unir de la grilla (Vista en vivo o pantalla auxiliar): la página se esconde -->
            <views:WebCellView MergeMode="{Binding DataContext.IsMergeMode,
                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
