<Window x:Class="TrueCentralVms.Client.Views.IntercomCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        Title="Citofonía" Height="600" Width="1000"
        MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ShowInTaskbar="True" Topmost="True"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AnswerButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Background" Value="{StaticResource OkBrush}"/>
        </Style>
        <Style x:Key="HangButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
        </Style>
    </Window.Resources>
    <!-- Llamada de citofonía: la cámara del frente a la izquierda y, a la
         derecha, contestar / rechazar / colgar, el micrófono y la apertura
         de puerta. Sin llamada sirve para hablarle al visitante a mano. -->
    <Border x:Name="Frame" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="38" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/TrueCentralVms.Client;component/Assets/logo.png" Width="22" Height="22"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                        <Run Foreground="{StaticResource MutedBrush}" Text="— Citofonía"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick" ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;" ToolTip="Cerrar (en conversación, cuelga)"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Video del frente -->
            <Border Grid.Column="0" Background="Black" CornerRadius="6" Margin="0,0,12,0">
                <Grid>
                    <fl:FlyleafHost x:Name="VideoHost" Player="{Binding Player}"
                                    AttachedDragMove="None" KeyBindings="None"
                                    OpenOnDrop="None" SwapOnDrop="None"
                                    ToggleFullScreenOnDoubleClick="None"/>
                    <TextBlock x:Name="NoVideoText" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                               Text="Este frente no tiene cámara asociada. Un administrador puede elegirla en el panel web (Dispositivos → Citofonía)."/>
                </Grid>
            </Border>

            <!-- Acciones -->
            <DockPanel Grid.Column="1" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Border x:Name="StateBadge" CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                            Background="#33FBBF24">
                        <TextBlock x:Name="StateText" FontWeight="SemiBold" FontSize="11.5" Foreground="#FBBF24"
                                   Text="LLAMADA ENTRANTE"/>
                    </Border>
                    <TextBlock x:Name="IntercomName" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,2"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TimerText" FontSize="28" FontWeight="Light" Margin="0,14,0,14"
                               Foreground="{StaticResource TextBrush}" Text="00:00"/>

                    <!-- Sonando -->
                    <StackPanel x:Name="RingingPanel">
                        <Button x:Name="AnswerButton" Style="{StaticResource AnswerButton}" Click="OnAnswerClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE717;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Contestar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HangButton}" Click="OnRejectClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE778;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rechazar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SilenceButton" Style="{StaticResource SideButton}" Click="OnSilenceClick"
                                Content="Silenciar timbre en este puesto"/>
                    </StackPanel>

                    <!-- En conversación / hablando sin llamada -->
                    <StackPanel x:Name="TalkPanel" Visibility="Collapsed">
                        <Button x:Name="HangUpButton" Style="{StaticResource HangButton}" Click="OnHangUpClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE778;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HangUpText" Text="Colgar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="MuteToggle" Style="{StaticResource GhostToggle}" Padding="12,8" Margin="0,0,0,10"
                                      HorizontalContentAlignment="Center" Checked="OnMuteChanged" Unchecked="OnMuteChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MuteGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MuteText" Text="Silenciar mi micrófono" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="Mi micrófono" Style="{StaticResource FieldLabel}"/>
                        <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Margin="0,3,0,8"/>
                        <TextBlock Text="Visitante" Style="{StaticResource FieldLabel}"/>
                        <ProgressBar x:Name="RemoteMeter" Style="{StaticResource Meter}" Margin="0,3,0,8"
                                     Foreground="{StaticResource AccentBrush}"/>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE767;"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="OnVolumeChanged" VerticalAlignment="Center"
                                    ToolTip="Volumen del visitante en este equipo"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Sin llamada: hablarle al visitante a mano -->
                    <StackPanel x:Name="MonitorPanel" Visibility="Collapsed">
                        <Button x:Name="TalkButton" Style="{StaticResource CallButton}" Click="OnTalkClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hablar con el frente" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Puertas (siempre disponibles mientras el frente esté en la ventana) -->
                    <ItemsControl x:Name="DoorButtons">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SideButton}" Tag="{Binding Number}" Click="OnOpenDoorClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            </DockPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
