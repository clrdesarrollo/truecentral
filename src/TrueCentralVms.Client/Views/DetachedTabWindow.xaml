<!-- Viñeta extraída (como una pestaña de navegador arrastrada fuera de la
     ventana): el módulo entero en su propia ventana, para llevarlo a otro
     monitor. Arriba, su viñeta: arrastrarla de vuelta sobre la barra de
     viñetas de la ventana principal la devuelve. -->
<Window x:Class="TrueCentralVms.Client.Views.DetachedTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLR TrueCentral VMS"
        Width="1100" Height="680" MinWidth="700" MinHeight="440"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título con la viñeta (oculta en la pantalla completa de la grilla) -->
        <Border x:Name="TitleBar" Grid.Row="0" Height="42" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/TrueCentralVms.Client;component/Assets/logo.png" Width="26" Height="26"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Devolver la viñeta a la ventana principal (lo mismo que arrastrarla de vuelta) -->
                    <Button Style="{StaticResource TitleBarButton}" Click="OnReturnClick" Content="&#xE73F;"
                            ToolTip="Devolver a la ventana principal (también: arrastre la viñeta sobre las viñetas de la ventana principal)"/>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick"
                            ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;"/>
                </StackPanel>

                <!-- La viñeta: se arrastra (mueve la ventana) y, soltada sobre las viñetas de la
                     principal, vuelve a ella. Su ✕ cierra el módulo, como en la principal. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Grid x:Name="TabHeader" Background="Transparent" Cursor="Hand"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseLeftButtonDown="OnTabMouseDown"
                          ToolTip="Arrastre la viñeta sobre las viñetas de la ventana principal para devolverla">
                        <StackPanel Orientation="Horizontal" Margin="14,0,34,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TabGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TabTitle" FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Margin="8,0"/>
                        <Button x:Name="TabCloseButton" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Click="OnCloseClick"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- La vista del módulo: la misma de la ventana principal, con su estado -->
        <Grid x:Name="Host" Grid.Row="1"/>
    </Grid>
</Window>
