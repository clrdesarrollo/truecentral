<!-- Viñeta en su propia ventana, como una pestaña de navegador arrastrada fuera
     de la ventana: un módulo extraído de la principal (soltar su viñeta sobre la
     barra de viñetas de la principal lo devuelve) o un Centro de mando más,
     abierto con «+». -->
<Window x:Class="TrueCentralVms.Client.Views.DetachedTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLR TrueCentral VMS"
        Width="1280" Height="800" MinWidth="1024" MinHeight="768"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- «+» junto a la viñeta: otro Centro de mando, como la pestaña nueva de un navegador -->
        <Style x:Key="NewTabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de título con la viñeta (oculta en la pantalla completa de la grilla) -->
        <Border x:Name="TitleBar" Grid.Row="0" Height="42" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/TrueCentralVms.Client;component/Assets/logo.png" Width="26" Height="26"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Devolver la viñeta a la ventana principal (lo mismo que arrastrarla de vuelta) -->
                    <Button x:Name="ReturnButton" Style="{StaticResource TitleBarButton}" Click="OnReturnClick" Content="&#xE73F;"
                            ToolTip="Devolver a la ventana principal (también: arrastre la viñeta sobre las viñetas de la ventana principal)"/>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick"
                            ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;"/>
                </StackPanel>

                <!-- La viñeta: se arrastra (mueve la ventana) y, soltada sobre las viñetas de la
                     principal, vuelve a ella. Su ✕ cierra el módulo, como en la principal. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Grid x:Name="TabHeader" Background="Transparent" Cursor="Hand"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseLeftButtonDown="OnTabMouseDown">
                        <StackPanel Orientation="Horizontal" Margin="14,0,34,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TabGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TabTitle" FontSize="13" FontWeight="SemiBold" FontStretch="SemiCondensed"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Margin="8,0"/>
                        <Button x:Name="TabCloseButton" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Click="OnCloseClick"/>
                    </Grid>
                    <Button x:Name="NewButton" Style="{StaticResource NewTabButton}" Content="&#xE710;" Margin="2,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="OnNewClick"
                            ToolTip="Abrir otro Centro de mando (en una ventana nueva)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- La vista del módulo: la misma de la ventana principal, con su estado -->
        <Grid x:Name="Host" Grid.Row="1"/>

        <!-- Barra de estado: los avisos de este Centro de mando (subdividir, tableros, PTZ…) -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
