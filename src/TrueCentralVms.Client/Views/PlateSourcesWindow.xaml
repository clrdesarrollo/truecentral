<!-- Engranaje de la tarjeta «Últimas patentes»: de qué cámaras ANPR se muestran
     las lecturas. Misma receta de ventana que los demás diálogos: sin marco de
     Windows y ✕ propio. -->
<Window x:Class="TrueCentralVms.Client.Views.PlateSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cámaras de Últimas patentes — CLR TrueCentral VMS"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ShowInTaskbar="False"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Width="44" Click="OnCancelClick" ToolTip="Cancelar"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel Orientation="Horizontal" Margin="14,0">
                    <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Cámaras de «Últimas patentes»" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Padding="14,6" Content="Cancelar" Click="OnCancelClick"/>
                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0" Content="Aplicar"
                        IsDefault="True" Click="OnApplyClick"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="16,14,16,12">
            <TextBlock Text="Reconocimientos que muestra esta tarjeta" Foreground="{StaticResource MutedBrush}"
                       FontSize="11.5" Margin="0,0,0,6"/>
            <RadioButton x:Name="AllRadio" GroupName="PlateSources" Content="De todas las cámaras ANPR"
                         Foreground="{StaticResource TextBrush}" Margin="0,2" Checked="OnModeChanged"/>
            <RadioButton x:Name="SomeRadio" GroupName="PlateSources" Content="Solo de las cámaras marcadas"
                         Foreground="{StaticResource TextBrush}" Margin="0,2" Checked="OnModeChanged"/>
            <Border x:Name="ListBorder" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SourceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource DarkCheckBox}" IsChecked="{Binding IsChecked}" Margin="0,3"
                                          IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="12.5"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                   Margin="13,1,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="No hay cámaras ANPR a su alcance: se configuran en el panel web (Fuentes de video → ANPR)."/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Lo elegido queda con el cuadro: se recuerda en la última sesión y en los tableros."/>
        </StackPanel>
    </DockPanel>
</Window>
