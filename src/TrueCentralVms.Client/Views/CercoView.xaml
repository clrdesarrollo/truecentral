<UserControl x:Class="TrueCentralVms.Client.Views.CercoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WarnBrush" Color="#FCD34D"/>
        <SolidColorBrush x:Key="AlarmBgBrush" Color="#33EF4444"/>
        <SolidColorBrush x:Key="ArmedBgBrush" Color="#2622C55E"/>
        <SolidColorBrush x:Key="DisarmedBgBrush" Color="#268B98A5"/>
        <SolidColorBrush x:Key="PartialBgBrush" Color="#263B82F6"/>

        <!-- Píldora de estado: el color sale de Tag (mismo criterio que Paneles de alarma) -->
        <Style x:Key="LevelBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Background" Value="{StaticResource DisarmedBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Armed"><Setter Property="Background" Value="{StaticResource ArmedBgBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Normal"><Setter Property="Background" Value="{StaticResource DisarmedBgBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Partial"><Setter Property="Background" Value="{StaticResource PartialBgBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Alarm"><Setter Property="Background" Value="{StaticResource AlarmBgBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Triggered"><Setter Property="Background" Value="#33FCD34D"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Armed"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Partial"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Alarm"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Triggered"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SmallPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SmallDanger" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- Tarjeta de panel: borde rojo mientras hay algo que atender -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="320"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InAlarm}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Cerco eléctrico" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Estado en tiempo real. Las alarmas suenan en este puesto aunque la viñeta esté cerrada."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding StatusMessage, Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
        </StackPanel>

        <!-- Paneles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="No hay paneles de cerco configurados. Un administrador los agrega desde el panel web (Configuración → Paneles de cerco)."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                           Visibility="{Binding HasPanels, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                <ItemsControl ItemsSource="{Binding Panels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,8"/>

                                    <WrapPanel Margin="0,0,0,8">
                                        <Border Style="{StaticResource LevelBadge}" Tag="{Binding Level}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding Level}" Text="{Binding StateText}"/>
                                        </Border>
                                        <Border Style="{StaticResource LevelBadge}" Tag="Alarm"
                                                Visibility="{Binding Siren, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="Alarm" Text="Sirena sonando"/>
                                        </Border>
                                        <Border Style="{StaticResource LevelBadge}" Tag="Alarm"
                                                Visibility="{Binding FenceDown, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="Alarm" Text="Cerco caído"/>
                                        </Border>
                                        <Border Style="{StaticResource LevelBadge}" Tag="Alarm"
                                                Visibility="{Binding ZoneAlarm, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="Alarm" Text="{Binding ZoneText}"/>
                                        </Border>
                                        <Border Style="{StaticResource LevelBadge}" Tag="Triggered"
                                                Visibility="{Binding PulseMissing, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="Triggered" Text="Sin retorno"/>
                                        </Border>
                                        <Border Style="{StaticResource LevelBadge}" Tag="Normal"
                                                Visibility="{Binding LevelText, Converter={x:Static vm:NonEmptyToVisibility.Instance}}">
                                            <TextBlock Style="{StaticResource LevelBadgeText}" Tag="Normal" Text="{Binding LevelText}"/>
                                        </Border>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SmallPrimary}" Content="Armar"
                                                IsEnabled="{Binding CanArm}"
                                                Command="{Binding DataContext.ArmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallGhost}" Content="Desarmar"
                                                IsEnabled="{Binding CanDisarm}"
                                                Command="{Binding DataContext.DisarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallDanger}" Content="Silenciar"
                                                IsEnabled="{Binding CanSilence}"
                                                Command="{Binding DataContext.SilenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Eventos recientes -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Eventos recientes" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding PanelName}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Border Style="{StaticResource LevelBadge}" Tag="{Binding Level}">
                                                <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding Level}" Text="{Binding Description}"/>
                                            </Border>
                                            <TextBlock Text="{Binding ZoneText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
