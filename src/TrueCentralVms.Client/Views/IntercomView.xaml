<UserControl x:Class="TrueCentralVms.Client.Views.IntercomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SmallPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Píldora del resultado de una llamada (color según Tag = estado) -->
        <Style x:Key="ResultBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#268B98A5"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Completed"><Setter Property="Background" Value="#2622C55E"/></Trigger>
                <Trigger Property="Tag" Value="InCall"><Setter Property="Background" Value="#2622C55E"/></Trigger>
                <Trigger Property="Tag" Value="Missed"><Setter Property="Background" Value="#33EF4444"/></Trigger>
                <Trigger Property="Tag" Value="Ringing"><Setter Property="Background" Value="#33FBBF24"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IntercomListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderThickness="3,0,0,1"
                                BorderBrush="Transparent" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Frentes -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,14,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FRENTES DE CITOFONÍA" Style="{StaticResource FieldLabel}"
                           FontWeight="SemiBold" Margin="14,12,14,8"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5" TextWrapping="Wrap" Margin="14,8"/>
                <Grid>
                    <ListBox ItemsSource="{Binding Intercoms}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource IntercomListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IntercomItemViewModel}">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CallText}" FontSize="11.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                               Margin="17,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               Margin="17,1,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="17,0,0,0">
                                        <Button Style="{StaticResource SmallPrimary}" Content="Ver y hablar"
                                                Command="{Binding DataContext.OpenWindowCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallGhost}" Content="Abrir puerta"
                                                Command="{Binding DataContext.OpenDoorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No hay frentes de citofonía. Un administrador los agrega en el panel web (Dispositivos → Citofonía)."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="24" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Historial -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,10,10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="Actualizar"
                            Command="{Binding LoadHistoryCommand}"/>
                    <TextBlock Text="ÚLTIMAS LLAMADAS" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Inicio" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Text="Frente" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="2" Text="Resultado" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="3" Text="Atendió" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="4" Text="Duración" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="5" Text="Puerta" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="6" Text="Detalle" Style="{StaticResource FieldLabel}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IntercomCallRow}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IntercomName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Style="{StaticResource ResultBadge}" Tag="{Binding ResultKey}">
                                            <TextBlock Text="{Binding Result}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding AnsweredBy}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Door}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Detail}" FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
