<Window x:Class="TrueCentralVms.Client.Views.FleetMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mapa de flota"
        Width="1200" Height="760" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="/TrueCentralVms.Client;component/Assets/logo.png"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <!-- Mapa de flota (módulo Flota): la página Flota → Mapa del panel web en un WebView2 con la sesión del cliente.
         "Abrir en grilla" de la ficha abre las cámaras en la ventana nativa Flota en vivo. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="38" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/TrueCentralVms.Client;component/Assets/logo.png" Width="22" Height="22" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                        <Run Foreground="{StaticResource MutedBrush}" Text="Mapa de flota"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnReloadClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE72C;" ToolTip="Recargar el mapa"/>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick"
                            ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;" ToolTip="Cerrar el mapa (detiene el video de la ficha)"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" DefaultBackgroundColor="#15181D"/>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="40"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620"
                   Foreground="{StaticResource TextBrush}" FontSize="13"/>
    </Grid>
</Window>
