<Window x:Class="TrueCentralVms.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — CLR TrueCentral VMS"
        Width="680" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Misma receta del shell: sin marco de Windows, franja superior
         arrastrable y ✕ propio. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Ítem del menú de apartados -->
        <Style x:Key="SectionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,8" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2733"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Barra de título -->
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Width="44" Click="OnCancelClick" ToolTip="Cerrar sin guardar"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel Orientation="Horizontal" Margin="14,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Configuración" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Pie: guardar / cancelar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="11.5"
                           VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Padding="16,7"
                            Click="OnCancelClick" Margin="0,0,8,0"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Padding="20,7"
                            Click="OnSaveClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Menú de apartados -->
        <Border DockPanel.Dock="Left" Width="160" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
            <StackPanel>
                <RadioButton x:Name="NavVideo" Content="Video" Style="{StaticResource SectionRadio}"
                             IsChecked="True" Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavImagen" Content="Imagen" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavSonido" Content="Sonido" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavRed" Content="Red" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
            </StackPanel>
        </Border>
        <!-- Contenido del apartado -->
        <Grid Margin="22,18">
            <!-- ============ VIDEO ============ -->
            <StackPanel x:Name="SectionVideo">
                <TextBlock Text="Video" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Stream al abrir un canal" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="ProfileAuto" Content="Automático" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                    <RadioButton x:Name="ProfileMain" Content="Principal" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                    <RadioButton x:Name="ProfileSub" Content="Secundario" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Automático usa el stream principal en divisiones de hasta 4 cuadros y el secundario en las más grandes. El botón P/S de cada cuadro sigue disponible como ajuste manual."/>

                <TextBlock Text="Ajuste de imagen" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FitKeep" Content="Mantener proporción" Style="{StaticResource OptionRadio}"
                                 GroupName="Fit"/>
                    <RadioButton x:Name="FitStretch" Content="Estirar al cuadro" Style="{StaticResource OptionRadio}"
                                 GroupName="Fit"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Estirar llena cada cuadro por completo (sin barras negras) deformando levemente la imagen. Se aplica a todos los cuadros al guardar."/>

                <TextBlock Text="Al abrir un equipo completo (doble clic en el árbol)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GridFit" Content="Grilla ajustada al equipo" Style="{StaticResource OptionRadio}"
                                 GroupName="DeviceGrid"/>
                    <RadioButton x:Name="GridStandard" Content="División estándar más cercana" Style="{StaticResource OptionRadio}"
                                 GroupName="DeviceGrid"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Ajustada arma una cuadrícula a medida sin cuadros de sobra (ej.: 40 cámaras → 8×5). La división estándar usa el selector de siempre (…16/25/36/64)."/>

                <TextBlock Text="Carpeta de grabaciones locales" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="6,0,0,0" Click="OnBrowseRecording"/>
                    <TextBox x:Name="RecordingFolderBox" Style="{StaticResource DarkTextBox}"/>
                </DockPanel>
                <TextBlock x:Name="RecordingHint" Style="{StaticResource SettingHint}"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Las cápsulas se graban tal como llegan de la cámara (sin recomprimir): no consumen CPU extra."/>
            </StackPanel>

            <!-- ============ IMAGEN ============ -->
            <StackPanel x:Name="SectionImagen" Visibility="Collapsed">
                <TextBlock Text="Imagen" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Carpeta de capturas" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="6,0,0,0" Click="OnBrowseSnapshot"/>
                    <TextBox x:Name="SnapshotFolderBox" Style="{StaticResource DarkTextBox}"/>
                </DockPanel>
                <TextBlock x:Name="SnapshotHint" Style="{StaticResource SettingHint}"/>

                <TextBlock Text="Formato de captura" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FormatJpg" Content="JPG (liviano)" Style="{StaticResource OptionRadio}"
                                 GroupName="Format"/>
                    <RadioButton x:Name="FormatPng" Content="PNG (sin pérdida)" Style="{StaticResource OptionRadio}"
                                 GroupName="Format"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ SONIDO ============ -->
            <StackPanel x:Name="SectionSonido" Visibility="Collapsed">
                <TextBlock Text="Sonido" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Volumen inicial de los cuadros" Style="{StaticResource FieldLabel}"/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Width="34" TextAlignment="Right"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                            TickFrequency="5" VerticalAlignment="Center"
                            ValueChanged="OnVolumeChanged"/>
                </DockPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Se aplica a los cuadros que se creen desde ahora (al cambiar la división o reabrir la Vista en Vivo). El audio de cada cuadro sigue partiendo silenciado; este es el volumen con el que suena al activarlo."/>
            </StackPanel>

            <!-- ============ RED ============ -->
            <StackPanel x:Name="SectionRed" Visibility="Collapsed">
                <TextBlock Text="Red" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Tiempo de espera de la API (segundos)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TimeoutBox" Style="{StaticResource DarkTextBox}" Width="90"
                         HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Entre 5 y 120 segundos. Se aplica al reiniciar la aplicación. El transporte de video es siempre RTSP sobre TCP."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
