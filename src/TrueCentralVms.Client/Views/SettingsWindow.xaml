<Window x:Class="TrueCentralVms.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — CLR TrueCentral VMS"
        Width="680" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Misma receta del shell: sin marco de Windows, franja superior
         arrastrable y ✕ propio. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Ítem del menú de apartados -->
        <Style x:Key="SectionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,8" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- Opción de apariencia: miniatura del diseño + nombre; la elegida
             queda con el borde en acento. -->
        <Style x:Key="AppearanceOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Barra de título -->
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Width="44" Click="OnCancelClick" ToolTip="Cerrar sin guardar"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <StackPanel Orientation="Horizontal" Margin="14,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Configuración" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Pie: guardar / cancelar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="11.5"
                           VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Padding="16,7"
                            Click="OnCancelClick" Margin="0,0,8,0"/>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Padding="20,7"
                            Click="OnSaveClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Menú de apartados -->
        <Border DockPanel.Dock="Left" Width="160" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
            <StackPanel>
                <RadioButton x:Name="NavVideo" Content="Video" Style="{StaticResource SectionRadio}"
                             IsChecked="True" Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavImagen" Content="Imagen" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavSonido" Content="Sonido" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavJoystick" Content="Joystick" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavRed" Content="Red" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavApariencia" Content="Apariencia" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavSistema" Content="Sistema" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
                <RadioButton x:Name="NavLicencia" Content="Licencia" Style="{StaticResource SectionRadio}"
                             Checked="OnSectionChanged"/>
            </StackPanel>
        </Border>
        <!-- Contenido del apartado -->
        <Grid Margin="22,18">
            <!-- ============ VIDEO ============ -->
            <StackPanel x:Name="SectionVideo">
                <TextBlock Text="Video" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Stream al abrir un canal" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="ProfileAuto" Content="Automático" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                    <RadioButton x:Name="ProfileMain" Content="Principal" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                    <RadioButton x:Name="ProfileSub" Content="Secundario" Style="{StaticResource OptionRadio}"
                                 GroupName="Profile"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Automático usa el stream principal en divisiones de hasta 4 cuadros y el secundario en las más grandes. El botón P/S de cada cuadro sigue disponible como ajuste manual."/>

                <TextBlock Text="Ajuste de imagen" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FitKeep" Content="Mantener proporción" Style="{StaticResource OptionRadio}"
                                 GroupName="Fit"/>
                    <RadioButton x:Name="FitStretch" Content="Estirar al cuadro" Style="{StaticResource OptionRadio}"
                                 GroupName="Fit"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Estirar llena cada cuadro por completo (sin barras negras) deformando levemente la imagen. Se aplica a todos los cuadros al guardar."/>

                <TextBlock Text="Al abrir un equipo completo (doble clic en el árbol)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GridFit" Content="Grilla ajustada al equipo" Style="{StaticResource OptionRadio}"
                                 GroupName="DeviceGrid"/>
                    <RadioButton x:Name="GridStandard" Content="División estándar más cercana" Style="{StaticResource OptionRadio}"
                                 GroupName="DeviceGrid"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Ajustada arma una cuadrícula a medida sin cuadros de sobra (ej.: 40 cámaras → 8×5). La división estándar usa el selector de siempre (…16/25/36/64)."/>

                <TextBlock Text="Al iniciar sesión" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <CheckBox x:Name="RestoreSessionCheck" Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"
                          Content="Volver a abrir las cámaras de la última sesión"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Reabre la Vista en Vivo como quedó: la división, la cámara y el stream de cada cuadro, y las pantallas auxiliares en su monitor. Se recuerda a medida que cambia, así que también vale si el cliente se cerró de golpe. Es por usuario: otra persona que ingrese en este equipo no hereda sus cámaras."/>

                <TextBlock Text="Carpeta de grabaciones locales" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="6,0,0,0" Click="OnBrowseRecording"/>
                    <TextBox x:Name="RecordingFolderBox" Style="{StaticResource DarkTextBox}"/>
                </DockPanel>
                <TextBlock x:Name="RecordingHint" Style="{StaticResource SettingHint}"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Las cápsulas se graban tal como llegan de la cámara (sin recomprimir): no consumen CPU extra."/>
            </StackPanel>

            <!-- ============ IMAGEN ============ -->
            <StackPanel x:Name="SectionImagen" Visibility="Collapsed">
                <TextBlock Text="Imagen" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Carpeta de capturas" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Examinar…" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="6,0,0,0" Click="OnBrowseSnapshot"/>
                    <TextBox x:Name="SnapshotFolderBox" Style="{StaticResource DarkTextBox}"/>
                </DockPanel>
                <TextBlock x:Name="SnapshotHint" Style="{StaticResource SettingHint}"/>

                <TextBlock Text="Formato de captura" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FormatJpg" Content="JPG (liviano)" Style="{StaticResource OptionRadio}"
                                 GroupName="Format"/>
                    <RadioButton x:Name="FormatPng" Content="PNG (sin pérdida)" Style="{StaticResource OptionRadio}"
                                 GroupName="Format"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ SONIDO ============ -->
            <StackPanel x:Name="SectionSonido" Visibility="Collapsed">
                <TextBlock Text="Sonido" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Volumen inicial de los cuadros" Style="{StaticResource FieldLabel}"/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Width="34" TextAlignment="Right"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                            TickFrequency="5" VerticalAlignment="Center"
                            ValueChanged="OnVolumeChanged"/>
                </DockPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Se aplica a los cuadros que se creen desde ahora (al cambiar la división o reabrir la Vista en Vivo). El audio de cada cuadro sigue partiendo silenciado; este es el volumen con el que suena al activarlo."/>
            </StackPanel>

            <!-- ============ JOYSTICK PTZ ============ -->
            <StackPanel x:Name="SectionJoystick" Visibility="Collapsed">
                <TextBlock Text="Joystick PTZ" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="JoystickStateText" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="JoystickLiveText" Style="{StaticResource SettingHint}" FontFamily="Consolas"/>
                <StackPanel x:Name="JoystickOptions" Margin="0,8,0,0" IsEnabled="False">
                    <CheckBox x:Name="JoystickEnabledCheck" Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"
                              Content="Mover la cámara PTZ seleccionada con el joystick"/>
                    <CheckBox x:Name="JoystickInvertYCheck" Style="{StaticResource DarkCheckBox}" Margin="0,8,0,0"
                              Content="Invertir arriba y abajo"/>
                    <CheckBox x:Name="JoystickInvertZoomCheck" Style="{StaticResource DarkCheckBox}" Margin="0,8,0,0"
                              Content="Invertir el zoom del giro"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Asignar botones…" Style="{StaticResource GhostButton}" Padding="12,6"
                                Click="OnJoystickButtonsClick"/>
                        <TextBlock x:Name="JoystickButtonsText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Sirve cualquier joystick que Windows reconozca como mando de juego. En la Vista en Vivo, la palanca mueve la cámara PTZ del cuadro seleccionado (más rápido cuanto más se inclina) y el giro hace zoom, a la vez. Actúa con una ventana del cliente activa y la detiene al soltar. Los ajustes se guardan por modelo de joystick; los botones, al asignarlos."/>
            </StackPanel>

            <!-- ============ RED ============ -->
            <StackPanel x:Name="SectionRed" Visibility="Collapsed">
                <TextBlock Text="Red" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Tiempo de espera de la API (segundos)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TimeoutBox" Style="{StaticResource DarkTextBox}" Width="90"
                         HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Entre 5 y 120 segundos. Se aplica al reiniciar la aplicación. El transporte de video es siempre RTSP sobre TCP."/>
            </StackPanel>

            <!-- ============ APARIENCIA ============ -->
            <StackPanel x:Name="SectionApariencia" Visibility="Collapsed">
                <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Diseño del cliente" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton x:Name="AppearanceClassic" GroupName="Appearance" Style="{StaticResource AppearanceOption}"
                                 ToolTip="El diseño de siempre: azul pizarra, tarjetas redondeadas">
                        <StackPanel>
                            <Border Width="150" Height="70" Background="#0F141A" BorderBrush="#263241" BorderThickness="1"
                                    CornerRadius="5" ClipToBounds="True">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="12" Background="#171F28">
                                        <Border Width="26" Height="6" CornerRadius="3" Background="#3B82F6"
                                                HorizontalAlignment="Left" Margin="18,0,0,0"/>
                                    </Border>
                                    <Border DockPanel.Dock="Left" Width="12" Background="#171F28"/>
                                    <UniformGrid Columns="2" Rows="2" Margin="6">
                                        <Border Background="#171F28" CornerRadius="4" Margin="2"/>
                                        <Border Background="#171F28" CornerRadius="4" Margin="2"/>
                                        <Border Background="#171F28" CornerRadius="4" Margin="2"/>
                                        <Border Background="#171F28" CornerRadius="4" Margin="2"/>
                                    </UniformGrid>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Clásica" FontWeight="SemiBold" Margin="2,6,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AppearanceConsole" GroupName="Appearance" Style="{StaticResource AppearanceOption}"
                                 ToolTip="Consola técnica: tipografía condensada, telemetría por cuadro y botonera abajo">
                        <StackPanel>
                            <Border Width="150" Height="70" Background="#141414" BorderBrush="#333435" BorderThickness="1"
                                    CornerRadius="1" ClipToBounds="True">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="11" Background="#313131">
                                        <Border Width="22" Height="2" Background="#3A96EC" VerticalAlignment="Bottom"
                                                HorizontalAlignment="Left" Margin="18,0,0,0"/>
                                    </Border>
                                    <Border DockPanel.Dock="Left" Width="11" Background="#1C1C1C"/>
                                    <!-- Botonera flotante abajo -->
                                    <Border DockPanel.Dock="Bottom" Height="7" Width="40" Margin="0,0,0,4"
                                            BorderBrush="#3A96EC" BorderThickness="1" CornerRadius="1"/>
                                    <UniformGrid Columns="2" Rows="1" Margin="4,5,4,4">
                                        <Border Background="#060606" BorderBrush="#333435" BorderThickness="1" Margin="2">
                                            <Border Height="5" Background="#0A0A0A" VerticalAlignment="Bottom">
                                                <Border Width="12" Height="1.5" Background="#EDEDED" HorizontalAlignment="Left" Margin="3,0"/>
                                            </Border>
                                        </Border>
                                        <Border Background="#060606" BorderBrush="#333435" BorderThickness="1" Margin="2">
                                            <Border Height="5" Background="#0A0A0A" VerticalAlignment="Bottom">
                                                <Border Width="12" Height="1.5" Background="#EDEDED" HorizontalAlignment="Left" Margin="3,0"/>
                                            </Border>
                                        </Border>
                                    </UniformGrid>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Consola" FontWeight="SemiBold" Margin="2,6,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingHint}" Margin="0,8,0,0"
                           Text="Consola: tipografía técnica y cifras en monoespaciada, telemetría bajo cada cuadro de video (códec, resolución, FPS, stream y tiempo en vivo) y la botonera de la Vista en Vivo abajo."/>

                <!-- Paleta: solo aplica a la Consola -->
                <TextBlock Text="Paleta de la Consola" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                <ItemsControl x:Name="PaletteList" Focusable="False"
                              IsEnabled="{Binding IsChecked, ElementName=AppearanceConsole}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="ConsolePalette" Style="{StaticResource AppearanceOption}"
                                         Margin="0,0,8,0" Padding="6" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         ToolTip="{Binding Palette.Description}">
                                <StackPanel>
                                    <!-- Muestra: fondo, panel con el acento y las cuatro señales -->
                                    <Border Width="92" Height="34" Background="{Binding Palette.Bg}"
                                            BorderBrush="{Binding Palette.Border}" BorderThickness="1" CornerRadius="1">
                                        <Border Background="{Binding Palette.Panel}" Margin="5" BorderBrush="{Binding Palette.Border}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                                <Border Width="18" Height="4" Background="{Binding Palette.Accent}" Margin="0,0,6,0"/>
                                                <Ellipse Width="6" Height="6" Fill="{Binding Palette.Ok}" Margin="0,0,3,0"/>
                                                <Ellipse Width="6" Height="6" Fill="{Binding Palette.Info}" Margin="0,0,3,0"/>
                                                <Ellipse Width="6" Height="6" Fill="{Binding Palette.Warn}" Margin="0,0,3,0"/>
                                                <Ellipse Width="6" Height="6" Fill="{Binding Palette.Danger}"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding Palette.Name}" FontSize="12" Margin="2,5,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SettingHint}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"
                           Text="El diseño y la paleta se aplican la próxima vez que abra el cliente."/>
            </StackPanel>

            <!-- ============ SISTEMA ============ -->
            <StackPanel x:Name="SectionSistema" Visibility="Collapsed">
                <TextBlock Text="Sistema" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Inicio de sesión" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="AutoLoginCheck" Style="{StaticResource DarkCheckBox}" Margin="0,8,0,0"
                          Content="Iniciar sesión automáticamente al abrir el cliente"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Apagado, el cliente pide siempre usuario y contraseña. Es lo recomendado en puestos compartidos: con el auto-login encendido, cualquiera que encienda el equipo entra con la cuenta recordada."/>
                <TextBlock x:Name="AutoLoginAccountText" Style="{StaticResource SettingHint}"/>

                <TextBlock Text="Ventana de alarma" Style="{StaticResource FieldLabel}" Margin="0,18,0,4"/>
                <CheckBox x:Name="AlertPlacementCheck" Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"
                          Content="Abrir la ventana de alarma donde quedó la última vez"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="Apagado, la alarma aparece centrada sobre la ventana principal. Encendido, se abre en el monitor, la posición y el tamaño en que se cerró la anterior: en puestos con dos pantallas basta con arrastrarla una vez a la de trabajo. Si ese monitor ya no está conectado, vuelve a aparecer centrada."/>
            </StackPanel>

            <!-- ============ LICENCIA (solo lectura; se administra en el panel web) ============ -->
            <StackPanel x:Name="SectionLicencia" Visibility="Collapsed">
                <TextBlock Text="Licencia del servidor" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="LicenseStateText" Foreground="{StaticResource TextBrush}" FontSize="13"
                           FontWeight="SemiBold" Text="Consultando…"/>
                <TextBlock x:Name="LicenseWarningText" Foreground="#F59E0B" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="LicenseDetailText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Módulos y cupos" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <TextBlock x:Name="LicenseModulesText" Foreground="{StaticResource TextBrush}" FontSize="11.5"
                           TextWrapping="Wrap" FontFamily="Consolas"/>
                <TextBlock Style="{StaticResource SettingHint}"
                           Text="La activación, la importación del archivo .lic y las expansiones se administran en el panel web del servidor (Sistema → Licencia)."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
