<Window x:Class="TrueCentralVms.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
        xmlns:views="clr-namespace:TrueCentralVms.Client.Views"
        Title="CLR TrueCentral VMS"
        Width="1280" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Barra de título propia: el marco estándar de Windows se reemplaza por
         WindowChrome. CaptionHeight define el área de arrastre (la fila
         superior); los controles dentro de ella marcan IsHitTestVisibleInChrome.
         GlassFrameThickness 0,0,0,1 conserva la sombra de DWM. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Botones del riel con estado activo según la sección visible -->
        <Style x:Key="RailHomeButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Home">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailLiveButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Live">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailPlaybackButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Playback">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailWallButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Wall">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailLprButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Lpr">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Paneles de alarma: activo por sección y, con una alarma en curso,
             en rojo y pulsando aunque la viñeta esté cerrada. -->
        <Style x:Key="RailAlarmsButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Alarms">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Alarms.HasActiveAlarms}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="ToolTip" Value="Paneles de alarma: hay una alarma activa"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="AlarmPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="AlarmPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Centro de eventos: activo por sección y, con alertas sin confirmar,
             en rojo y pulsando (más la insignia con el número) aunque la
             viñeta esté cerrada. -->
        <Style x:Key="RailEventsButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Events">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPendingAlerts}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="ToolTip" Value="Centro de eventos: hay alertas sin confirmar"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="EventsPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="EventsPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Centro de descargas: el icono se enciende (y pulsa suave) mientras
             haya una descarga en curso o en cola, aunque la ventana esté cerrada. -->
        <Style x:Key="RailDownloadButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Downloads.HasActiveJobs}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="ToolTip" Value="Centro de descargas — hay descargas en curso"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="DownloadPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.45" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="DownloadPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Indicadores de recursos del servidor: gris normal, amarillo ≥70 %,
             rojo ≥90 % (el nivel llega en Tag; el detalle, en el ToolTip). -->
        <Style x:Key="MetricIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <!-- Están dentro del área de arrastre del WindowChrome: sin esto
                 el caption se traga el mouse y el tooltip jamás aparece. -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warn">
                    <Setter Property="Foreground" Value="#FCD34D"/>
                </Trigger>
                <Trigger Property="Tag" Value="Crit">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Usuario del navbar: botón que despliega el menú de la sesión. Va
             dentro del área de arrastre del WindowChrome, así que marca
             IsHitTestVisibleInChrome para que el clic llegue al botón. -->
        <Style x:Key="UserMenuToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Acción del menú del usuario (fila completa, alineada a la izquierda) -->
        <Style x:Key="UserMenuItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0,0,7,7" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22303F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Navbar / barra de título (oculto en pantalla completa) ===== -->
        <Border Grid.Row="0" Height="42" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de ventana -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick"
                            ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;" ToolTip="Cerrar"/>
                </StackPanel>

                <!-- Estado de conexión y usuario -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <!-- Salud del servidor: CPU / RAM / disco -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                Visibility="{Binding HasMetrics, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xE950;"
                                   Tag="{Binding CpuLevel}" ToolTip="{Binding CpuTooltip}"/>
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xE964;"
                                   Tag="{Binding RamLevel}" ToolTip="{Binding RamTooltip}"/>
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xEDA2;"
                                   Tag="{Binding DiskLevel}" ToolTip="{Binding DiskTooltip}"/>
                    </StackPanel>
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- Usuario: abre el menú de la sesión (servidor + cerrar sesión) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="UserMenuToggle" Style="{StaticResource UserMenuToggle}"
                                      ToolTip="Sesión">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           VerticalAlignment="Center" Margin="7,1,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <!-- Se alinea a la derecha del botón: ver PlaceUserMenu en el código -->
                        <Popup x:Name="UserMenuPopup" PlacementTarget="{Binding ElementName=UserMenuToggle}"
                               Placement="Custom" AllowsTransparency="True" StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=UserMenuToggle}">
                            <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" MinWidth="248" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Cabecera: quién soy (informativa, no cliqueable) -->
                                    <StackPanel Margin="14,12,14,10">
                                        <TextBlock Text="{Binding UserLabel}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                                    <!-- Servidor de esta sesión (informativo, no cliqueable) -->
                                    <StackPanel Margin="14,10,14,12">
                                        <TextBlock Text="Conectado al servidor" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10.5"/>
                                        <TextBlock Text="{Binding ServerLabel}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ServerLabel}"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                                    <Button Style="{StaticResource UserMenuItem}" Click="OnLogoutClick"
                                            ToolTip="Cerrar la sesión y volver a la pantalla de inicio de sesión">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Viñetas de módulos -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                 IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                             Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- Viñeta Vista en Vivo: existe solo mientras el módulo está abierto -->
                    <Grid Visibility="{Binding IsLiveViewOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Live}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Vista en Vivo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseLiveViewCommand}"
                                ToolTip="Cerrar Vista en Vivo (detiene los streams)"/>
                    </Grid>
                    <Grid Visibility="{Binding IsPlaybackOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Playback}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Reproducción" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding ClosePlaybackCommand}"
                                ToolTip="Cerrar Reproducción (detiene el video)"/>
                    </Grid>
                    <!-- Viñeta Muro de video: cerrarla solo la saca de la vista;
                         el muro sigue mostrando lo que tenga (lo decodifica el equipo). -->
                    <Grid Visibility="{Binding IsWallOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Wall}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Muro de video" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseWallCommand}"
                                ToolTip="Cerrar Muro de video"/>
                    </Grid>
                    <!-- Paneles de alarma: cerrar la viñeta no desconecta nada,
                         el servidor sigue recibiendo los eventos de los paneles. -->
                    <Grid Visibility="{Binding IsAlarmsOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Alarms}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE730;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Paneles de alarma" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseAlarmsCommand}"
                                ToolTip="Cerrar Paneles de alarma"/>
                    </Grid>
                    <!-- Centro de eventos: historial de alertas y acuse de
                         recibo. Puede sacarse a su propia ventana. -->
                    <Grid Visibility="{Binding IsEventsOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Events}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Centro de eventos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseEventsCommand}"
                                ToolTip="Cerrar Centro de eventos"/>
                    </Grid>
                    <!-- Aplicaciones → Reconocimiento de patentes. Cerrar la
                         viñeta no detiene nada: el servidor sigue recibiendo
                         y guardando las lecturas de las cámaras. -->
                    <Grid Visibility="{Binding IsLprOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Lpr}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE804;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Reconocimiento de patentes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseLprCommand}"
                                ToolTip="Cerrar Reconocimiento de patentes"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Contenido: menú lateral + página activa ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú de navegación lateral (oculto en pantalla completa) -->
            <Border Grid.Column="0" Width="52" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <Button Style="{StaticResource RailDownloadButton}" Content="&#xE896;"
                                ToolTip="Centro de descargas"
                                Command="{Binding OpenDownloadCenterCommand}"/>
                        <Button Style="{StaticResource RailButton}" Content="&#xE713;"
                                ToolTip="Configuración"
                                Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource RailHomeButton}" Content="&#xE80F;" ToolTip="Inicio"
                                Command="{Binding GoHomeCommand}"/>
                        <Button Style="{StaticResource RailLiveButton}" Content="&#xE714;" ToolTip="Vista en Vivo"
                                Command="{Binding OpenLiveViewCommand}"/>
                        <Button Style="{StaticResource RailPlaybackButton}" Content="&#xE768;"
                                ToolTip="Reproducción"
                                Command="{Binding OpenPlaybackCommand}"/>
                        <Button Style="{StaticResource RailWallButton}" Content="&#xE7F4;"
                                ToolTip="Muro de video"
                                Command="{Binding OpenWallCommand}"/>
                        <Button Style="{StaticResource RailAlarmsButton}" Content="&#xE730;"
                                ToolTip="Paneles de alarma"
                                Command="{Binding OpenAlarmsCommand}"/>
                        <Grid>
                            <Button Style="{StaticResource RailEventsButton}" Content="&#xE7BA;"
                                    ToolTip="Centro de eventos — alertas y acuse de recibo"
                                    Command="{Binding OpenEventCenterCommand}"/>
                            <!-- Insignia: cuántas alertas siguen sin confirmar -->
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="8"
                                    MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasPendingAlerts, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <TextBlock Text="{Binding PendingAlertCount}" Foreground="White"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <!-- Aplicaciones: módulos verticales sobre el inventario -->
                        <Separator Background="{StaticResource BorderBrush}" Margin="12,7" Height="1"/>
                        <Button Style="{StaticResource RailLprButton}" Content="&#xE804;"
                                ToolTip="Aplicaciones · Reconocimiento de patentes"
                                Command="{Binding OpenLprCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Páginas: se conmutan por Visibility para que la Vista en Vivo
                 conserve sus streams al pasar por Inicio -->
            <Grid Grid.Column="1">
                <views:HomeView Visibility="{Binding ActiveSection,
                                Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Home}"/>
                <views:LiveView Visibility="{Binding ActiveSection,
                                Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Live}"/>
                <views:PlaybackView Visibility="{Binding ActiveSection,
                                    Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Playback}"/>
                <views:WallView Visibility="{Binding ActiveSection,
                                Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Wall}"/>
                <views:AlarmsView DataContext="{Binding Alarms}"
                                  Visibility="{Binding DataContext.ActiveSection,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Alarms}"/>
                <views:EventCenterView DataContext="{Binding Events}"
                                       Visibility="{Binding DataContext.ActiveSection,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Events}"/>
                <!-- Este módulo tiene ViewModel propio, así que su DataContext
                     NO es el de la ventana: la visibilidad se ata al shell. -->
                <views:LprView DataContext="{Binding Lpr}"
                               Visibility="{Binding DataContext.ActiveSection,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Lpr}"/>
            </Grid>
        </Grid>

        <!-- ===== Barra de estado (oculta en pantalla completa) ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <!-- Aviso de licencia (prueba por vencer, gracia, restricción) -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding LicenseWarning}" FontSize="11.5" FontWeight="SemiBold"
                           Margin="16,0,0,0" ToolTip="{Binding LicenseWarning}" TextTrimming="CharacterEllipsis" MaxWidth="700"
                           Visibility="{Binding HasLicenseWarning, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F59E0B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LicenseRestricted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
