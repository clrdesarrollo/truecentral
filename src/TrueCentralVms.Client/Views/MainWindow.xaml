<Window x:Class="TrueCentralVms.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
        xmlns:views="clr-namespace:TrueCentralVms.Client.Views"
        Title="CLR TrueCentral VMS"
        Width="1280" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Barra de título propia: el marco estándar de Windows se reemplaza por
         WindowChrome. CaptionHeight define el área de arrastre (la fila
         superior); los controles dentro de ella marcan IsHitTestVisibleInChrome.
         GlassFrameThickness 0,0,0,1 conserva la sombra de DWM. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Botones del riel con estado activo según la sección visible -->
        <Style x:Key="RailHomeButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Home">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailLiveButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Live">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailPlaybackButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSection}" Value="Playback">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Indicadores de recursos del servidor: gris normal, amarillo ≥70 %,
             rojo ≥90 % (el nivel llega en Tag; el detalle, en el ToolTip). -->
        <Style x:Key="MetricIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <!-- Están dentro del área de arrastre del WindowChrome: sin esto
                 el caption se traga el mouse y el tooltip jamás aparece. -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warn">
                    <Setter Property="Foreground" Value="#FCD34D"/>
                </Trigger>
                <Trigger Property="Tag" Value="Crit">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Navbar / barra de título (oculto en pantalla completa) ===== -->
        <Border Grid.Row="0" Height="42" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,14,0">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        TrueCentral <Run Foreground="{StaticResource AccentBrush}">VMS</Run>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de ventana -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                            Content="&#xE921;" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Click="OnMaxRestoreClick"
                            ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick"
                            Content="&#xE8BB;" ToolTip="Cerrar"/>
                </StackPanel>

                <!-- Estado de conexión y usuario -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <!-- Salud del servidor: CPU / RAM / disco -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                Visibility="{Binding HasMetrics, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xE950;"
                                   Tag="{Binding CpuLevel}" ToolTip="{Binding CpuTooltip}"/>
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xE964;"
                                   Tag="{Binding RamLevel}" ToolTip="{Binding RamTooltip}"/>
                        <TextBlock Style="{StaticResource MetricIcon}" Text="&#xEDA2;"
                                   Tag="{Binding DiskLevel}" ToolTip="{Binding DiskTooltip}"/>
                    </StackPanel>
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding UserLabel}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Viñetas de módulos -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                 IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                             Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- Viñeta Vista en Vivo: existe solo mientras el módulo está abierto -->
                    <Grid Visibility="{Binding IsLiveViewOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Live}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Vista en Vivo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding CloseLiveViewCommand}"
                                ToolTip="Cerrar Vista en Vivo (detiene los streams)"/>
                    </Grid>
                    <Grid Visibility="{Binding IsPlaybackOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <RadioButton Style="{StaticResource NavTabRadio}" GroupName="NavTabs"
                                     Padding="14,0,34,0"
                                     IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                                 Converter={x:Static vm:SectionEquals.Instance}, ConverterParameter=Playback}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Reproducción" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Command="{Binding ClosePlaybackCommand}"
                                ToolTip="Cerrar Reproducción (detiene el video)"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Contenido: menú lateral + página activa ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú de navegación lateral (oculto en pantalla completa) -->
            <Border Grid.Column="0" Width="52" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <Button Style="{StaticResource RailButton}" Content="&#xE713;"
                                ToolTip="Configuración"
                                Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource RailHomeButton}" Content="&#xE80F;" ToolTip="Inicio"
                                Command="{Binding GoHomeCommand}"/>
                        <Button Style="{StaticResource RailLiveButton}" Content="&#xE714;" ToolTip="Vista en Vivo"
                                Command="{Binding OpenLiveViewCommand}"/>
                        <Button Style="{StaticResource RailPlaybackButton}" Content="&#xE768;"
                                ToolTip="Reproducción"
                                Command="{Binding OpenPlaybackCommand}"/>
                        <Button Style="{StaticResource RailButton}" Content="&#xE7BA;"
                                ToolTip="Centro de eventos (próximamente)"
                                Command="{Binding ShowComingSoonCommand}" CommandParameter="Centro de eventos"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Páginas: se conmutan por Visibility para que la Vista en Vivo
                 conserve sus streams al pasar por Inicio -->
            <Grid Grid.Column="1">
                <views:HomeView Visibility="{Binding ActiveSection,
                                Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Home}"/>
                <views:LiveView Visibility="{Binding ActiveSection,
                                Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Live}"/>
                <views:PlaybackView Visibility="{Binding ActiveSection,
                                    Converter={x:Static vm:SectionToVisibility.Instance}, ConverterParameter=Playback}"/>
            </Grid>
        </Grid>

        <!-- ===== Barra de estado (oculta en pantalla completa) ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
        </Border>
    </Grid>
</Window>
