<Window x:Class="TrueCentralVms.Client.Views.JoystickButtonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Botones del joystick — CLR TrueCentral VMS"
        Width="600" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="/Assets/logo.png"
        Background="{StaticResource BgBrush}">
    <!-- Misma receta que Configuración: sin marco de Windows y ✕ propio. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Width="44" Click="OnCloseClick" ToolTip="Cerrar"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock Text="Botones del joystick" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button Content="Quitar todas" Style="{StaticResource GhostButton}" Padding="14,7"
                        Click="OnClearAllClick"/>
                <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" Padding="20,7"
                        HorizontalAlignment="Right" Click="OnCloseClick"/>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
            <TextBlock x:Name="DeviceText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Elija «Asignar» en una acción y apriete el botón del joystick que la hará. Los dígitos arman el número de preset que llaman «Ir al preset» y «Guardar», como en un teclado PTZ. Cada botón se guarda apenas se asigna."/>
            <TextBlock x:Name="PressedText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,0,8,10">
            <ItemsControl x:Name="ActionList" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Quitar" Style="{StaticResource GhostButton}"
                                        Padding="10,4" Margin="6,0,0,0" Tag="{Binding Key}" Click="OnUnsetClick"
                                        Visibility="{Binding UnsetVisibility}"/>
                                <Button DockPanel.Dock="Right" Content="{Binding AssignText}" Style="{StaticResource GhostButton}"
                                        Padding="10,4" Tag="{Binding Key}" Click="OnAssignClick"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ButtonText}" Width="130"
                                           Foreground="{StaticResource TextBrush}" FontWeight="{Binding ButtonWeight}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
