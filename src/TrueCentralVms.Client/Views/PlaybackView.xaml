<UserControl x:Class="TrueCentralVms.Client.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             xmlns:views="clr-namespace:TrueCentralVms.Client.Views"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="10,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Árbol de canales -->
        <Border DockPanel.Dock="Left" Width="250" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GRABACIONES" Margin="14,12,14,8" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock DockPanel.Dock="Top" Margin="14,0,14,8" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Doble clic en un canal para ver sus grabaciones (viven en el disco del equipo). Ctrl + doble clic agrega el canal a la reproducción sincronizada (hasta 4)."/>
                <TreeView x:Name="PlaybackTree" ItemsSource="{Binding Devices}"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                          MouseDoubleClick="OnTreeDoubleClick">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceNode}" ItemsSource="{Binding Channels}">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,2"/>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelNode}">
                            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="Doble clic para ver sus grabaciones">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Header}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Barra superior: fecha + leyenda -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource LegendChip}" Background="#2E6BC4"/>
                    <TextBlock Text="Continua" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#F59E0B"/>
                    <TextBlock Text="Movimiento" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#EF4444"/>
                    <TextBlock Text="Alarma" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#A78BFA"/>
                    <TextBlock Text="Manual" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#6B7280"/>
                    <TextBlock Text="Otra" Style="{StaticResource LegendLabel}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Día:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Padding="8,5"
                            Command="{Binding Playback.PreviousDayCommand}" ToolTip="Día anterior"/>
                    <TextBlock Text="{Binding Playback.Date, StringFormat='dddd dd-MM-yyyy'}" Width="170"
                               TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Padding="8,5"
                            Command="{Binding Playback.NextDayCommand}" ToolTip="Día siguiente"/>
                    <Button Content="Hoy" Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                            Command="{Binding Playback.GoTodayCommand}"/>
                    <!-- Consulta de grabaciones en curso -->
                    <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center" Margin="14,0,0,0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"
                                 BorderThickness="0"
                                 Visibility="{Binding Playback.IsLoadingSegments, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Controles + línea de tiempo -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="10,8,10,4">
                    <StackPanel Orientation="Horizontal">
                        <!-- Pausa / reanudar -->
                        <Button Command="{Binding Playback.TogglePauseCommand}" Style="{StaticResource GhostButton}"
                                Padding="12,6" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                IsEnabled="{Binding Playback.IsPlaying}" ToolTip="Pausar / reanudar">
                            <Button.Content>
                                <TextBlock FontFamily="Segoe MDL2 Assets">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playback.IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <!-- Detener -->
                        <Button Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource GhostButton}" Padding="12,6" Margin="6,0,0,0"
                                Command="{Binding Playback.StopCommand}" IsEnabled="{Binding Playback.IsPlaying}"
                                ToolTip="Detener la reproducción"/>
                        <!-- Saltos relativos (piden un tramo nuevo al equipo) -->
                        <Button Content="−5 m" Style="{StaticResource GhostButton}" Padding="10,6" Margin="10,0,0,0"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="-300"
                                ToolTip="Retroceder 5 minutos"/>
                        <Button Content="−30 s" Style="{StaticResource GhostButton}" Padding="10,6" Margin="4,0,0,0"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="-30"
                                ToolTip="Retroceder 30 segundos"/>
                        <Button Content="+30 s" Style="{StaticResource GhostButton}" Padding="10,6" Margin="4,0,0,0"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="30"
                                ToolTip="Avanzar 30 segundos"/>
                        <Button Content="+5 m" Style="{StaticResource GhostButton}" Padding="10,6" Margin="4,0,0,0"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="300"
                                ToolTip="Avanzar 5 minutos"/>
                        <!-- Velocidad -->
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="10,0,0,0"
                                Command="{Binding Playback.CycleSpeedCommand}"
                                Content="{Binding Playback.Speed, StringFormat='{}{0:0.#}×'}"
                                ToolTip="Velocidad de reproducción (el equipo entrega el video a su propio ritmo)"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Playback.Playhead, StringFormat='HH:mm:ss'}"
                               Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBlock Text="{Binding Playback.Status}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Tramo marcado y exportación -->
                <DockPanel Margin="10,0,10,4">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="{Binding Playback.DownloadStatus}" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="0,0,10,0"/>
                        <Button Content="Cancelar" Style="{StaticResource GhostButton}" Padding="10,5"
                                Command="{Binding Playback.CancelDownloadCommand}"
                                Visibility="{Binding Playback.IsDownloading, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                                Command="{Binding Playback.PlaySelectionCommand}"
                                IsEnabled="{Binding Playback.HasSelection}"
                                Content="Reproducir tramo"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                                Command="{Binding Playback.DownloadCommand}"
                                IsEnabled="{Binding Playback.HasSelection}"
                                ToolTip="Guarda el tramo marcado del cuadro seleccionado como MP4 en la carpeta de grabaciones">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Exportar MP4"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tramo:" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Playback.SelectionText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontSize="11.5"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Style="{StaticResource GhostButton}" Padding="7,4" Margin="8,0,0,0"
                                Command="{Binding Playback.ClearSelectionCommand}"
                                Visibility="{Binding Playback.HasSelection, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                ToolTip="Borrar la marca"/>
                    </StackPanel>
                </DockPanel>

                <views:TimelineBar x:Name="Timeline" Height="70" Margin="10,2,10,10"
                                   Tracks="{Binding Playback.Tracks}"
                                   Day="{Binding Playback.Date}"
                                   Playhead="{Binding Playback.Playhead}"
                                   SelectionStart="{Binding Playback.SelectionStart}"
                                   SelectionEnd="{Binding Playback.SelectionEnd}"/>
            </StackPanel>
        </Border>

        <!-- Grilla de reproducción (un cuadro por canal, todos a la misma hora) -->
        <Grid Background="#06090D">
            <ItemsControl ItemsSource="{Binding Playback.Cells}" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:VideoLayoutPanel Layout="{Binding Playback.Layout}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlaybackCellViewModel}">
                        <!-- El video de FlyleafLib vive en una ventana nativa superpuesta:
                             los clics sobre él NO llegan a WPF, así que la barra del
                             cuadro es la que selecciona, silencia y cierra. -->
                        <Border Margin="3" Background="#0A0E13" CornerRadius="4" BorderThickness="2"
                                MouseLeftButtonDown="OnCellClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{x:Static vm:SelectedCellComparer.Instance}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.Playback.SelectedCell"
                                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Background="#151D26" Cursor="Hand">
                                    <Button DockPanel.Dock="Right" Content="&#x2715;" Command="{Binding CloseCommand}"
                                            Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                            BorderThickness="0" Padding="9,2" Cursor="Hand" FontSize="11"
                                            ToolTip="Quitar el canal de la reproducción"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleAudioCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="8,2" Cursor="Hand"
                                            ToolTip="Audio de este cuadro">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE74F;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudioOn}" Value="True">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <TextBlock Text="{Binding Title}" Margin="10,4" FontSize="11.5"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <fl:FlyleafHost Player="{Binding Player}" AttachedDragMove="None"
                                                    KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                                    ToggleFullScreenOnDoubleClick="None"
                                                    Visibility="{Binding IsPlaying, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                               Foreground="#5A6674" FontSize="11.5"
                                               Visibility="{Binding IsPlaying, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Elija un canal (doble clic en el árbol) y luego haga clic en la línea de tiempo para reproducir."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="420" Foreground="#3A4654" FontSize="12.5"
                       Visibility="{Binding Playback.Cells.Count, Converter={x:Static vm:ZeroToVisibility.Instance}}"/>
        </Grid>
    </DockPanel>
</UserControl>
