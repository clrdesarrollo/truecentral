<UserControl x:Class="TrueCentralVms.Client.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             xmlns:views="clr-namespace:TrueCentralVms.Client.Views"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <!-- Casilla de día del calendario: número, marca de grabación y estados
             (fuera del mes, futuro, hoy, seleccionado). El orden de los
             disparadores importa: el seleccionado va último para que gane
             sobre el paso del mouse. -->
        <Style x:Key="CalendarDayButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="Num" Text="{Binding Label}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"/>
                                <Border x:Name="Mark" Width="5" Height="5" CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasRecordings}" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Num" Property="Foreground" Value="#3A4654"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                <Setter TargetName="Num" Property="Foreground" Value="#2C3846"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Num" Property="Foreground" Value="White"/>
                                <Setter TargetName="Mark" Property="Background" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="10,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Árbol de canales -->
        <Border DockPanel.Dock="Left" Width="250" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GRABACIONES" Margin="14,12,14,8" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock DockPanel.Dock="Top" Margin="14,0,14,8" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Doble clic en un canal para sumarlo a la reproducción sincronizada (hasta 4; con la grilla llena reemplaza el cuadro seleccionado). Ctrl + doble clic deja solo ese canal."/>
                <TreeView x:Name="PlaybackTree" ItemsSource="{Binding Devices}"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                          MouseDoubleClick="OnTreeDoubleClick"
                          PreviewMouseLeftButtonDown="OnTreeMouseDown"
                          PreviewMouseMove="OnTreeMouseMove">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceNode}" ItemsSource="{Binding Channels}">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,2"/>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelNode}">
                            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="Doble clic para ver sus grabaciones">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Header}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Barra superior: fecha + leyenda -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource LegendChip}" Background="#2E6BC4"/>
                    <TextBlock Text="Continua" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#F59E0B"/>
                    <TextBlock Text="Movimiento" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#EF4444"/>
                    <TextBlock Text="Alarma" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#A78BFA"/>
                    <TextBlock Text="Manual" Style="{StaticResource LegendLabel}"/>
                    <Border Style="{StaticResource LegendChip}" Background="#6B7280"/>
                    <TextBlock Text="Otra" Style="{StaticResource LegendLabel}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Día:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Padding="8,5"
                            Command="{Binding Playback.PreviousDayCommand}" ToolTip="Día anterior"/>
                    <!-- La fecha abre el calendario: llegar a un día de la semana
                         pasada con las flechas era el camino largo. -->
                    <ToggleButton x:Name="CalendarToggle" Style="{StaticResource GhostToggle}"
                                  Width="196" Padding="6,5" Margin="6,0"
                                  IsChecked="{Binding Playback.Calendar.IsOpen, Mode=TwoWay}"
                                  ToolTip="Elegir fecha en el calendario">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Playback.Date, StringFormat='dddd dd-MM-yyyy'}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=CalendarToggle}" Placement="Bottom"
                           IsOpen="{Binding Playback.Calendar.IsOpen, Mode=TwoWay}" StaysOpen="False"
                           AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="4">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,10"
                                DataContext="{Binding Playback.Calendar}">
                            <StackPanel Width="252">
                                <!-- Mes visible -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Left" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                            FontSize="9" Style="{StaticResource GhostButton}" Padding="7,4"
                                            Command="{Binding PreviousMonthCommand}" ToolTip="Mes anterior"/>
                                    <Button DockPanel.Dock="Right" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                            FontSize="9" Style="{StaticResource GhostButton}" Padding="7,4"
                                            Command="{Binding NextMonthCommand}" ToolTip="Mes siguiente"/>
                                    <TextBlock Text="{Binding MonthLabel}" TextAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>

                                <!-- Iniciales de los días (la semana parte el lunes) -->
                                <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextAlignment="Center" FontSize="10.5"
                                                       Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CalendarDayButton}"
                                                    Command="{Binding DataContext.PickDayCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,8,0,0">
                                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="54" Height="3"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="{StaticResource Panel2Brush}"
                                                 Visibility="{Binding IsLoading,
                                                              Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" CornerRadius="1.5" VerticalAlignment="Center"
                                                Background="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="con grabación" Margin="6,0,0,0" FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Padding="8,5"
                            Command="{Binding Playback.NextDayCommand}" ToolTip="Día siguiente"/>
                    <Button Content="Hoy" Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                            Command="{Binding Playback.GoTodayCommand}"/>
                    <TextBlock Text="{Binding Playback.Cells.Count, StringFormat='{}{0} de 4 canales'}"
                               VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"/>
                    <!-- Consulta de grabaciones en curso -->
                    <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center" Margin="14,0,0,0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"
                                 BorderThickness="0"
                                 Visibility="{Binding Playback.IsLoadingSegments, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Controles + línea de tiempo -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="10,8,10,4">
                    <!-- Transporte -->
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding Playback.TogglePauseCommand}" Style="{StaticResource TransportButton}"
                                Margin="0" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                IsEnabled="{Binding Playback.CanControl}" ToolTip="Pausar / reanudar">
                            <Button.Content>
                                <TextBlock FontFamily="Segoe MDL2 Assets">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playback.IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <Button Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource TransportButton}"
                                Command="{Binding Playback.StopCommand}" IsEnabled="{Binding Playback.CanControl}"
                                ToolTip="Detener la reproducción"/>
                        <!-- Saltos relativos (piden un tramo nuevo al equipo) -->
                        <Button Content="−5 m" Style="{StaticResource TransportButton}" Margin="10,0,0,0"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="-300"
                                ToolTip="Retroceder 5 minutos"/>
                        <Button Content="−30 s" Style="{StaticResource TransportButton}"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="-30"
                                ToolTip="Retroceder 30 segundos (doble clic en el borde izquierdo del video)"/>
                        <Button Content="+30 s" Style="{StaticResource TransportButton}"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="30"
                                ToolTip="Avanzar 30 segundos (doble clic en el borde derecho del video)"/>
                        <Button Content="+5 m" Style="{StaticResource TransportButton}"
                                Command="{Binding Playback.SkipCommand}" CommandParameter="300"
                                ToolTip="Avanzar 5 minutos"/>
                        <!-- Velocidad -->
                        <Button Content="&#xE76B;&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Style="{StaticResource TransportButton}" Margin="10,0,0,0"
                                Command="{Binding Playback.SlowDownCommand}" ToolTip="Más lento"/>
                        <TextBlock Text="{Binding Playback.Speed, StringFormat='{}{0:0.##}×'}" Width="46"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <Button Content="&#xE76C;&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Style="{StaticResource TransportButton}" Margin="0"
                                Command="{Binding Playback.SpeedUpCommand}" ToolTip="Más rápido"/>
                    </StackPanel>

                    <!-- Herramientas -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ToggleButton IsChecked="{Binding Playback.IsDigitalZoomMode, Mode=TwoWay}"
                                      Checked="OnDigitalZoomToggled" Unchecked="OnDigitalZoomToggled"
                                      Style="{StaticResource GhostToggle}" Padding="10,6" Margin="0,0,6,0"
                                      ToolTip="Zoom digital: arrastre sobre el video para marcar el área a acercar (clic derecho vuelve a 1×)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Zoom" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding Playback.IsSelectionMode, Mode=TwoWay}"
                                      Style="{StaticResource GhostToggle}" Padding="10,6" Margin="0,0,6,0"
                                      ToolTip="Modo recorte: arrastrar sobre la línea de tiempo marca el tramo a exportar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Recorte" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,6,0"
                                Click="OnToggleFullscreen" ToolTip="Pantalla completa (doble clic al centro del video; Esc para salir)">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Reloj de reproducción -->
                    <TextBlock Text="{Binding Playback.PlayheadText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="14,0"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold"/>
                </DockPanel>

                <!-- Tramo marcado, exportación y estado -->
                <DockPanel Margin="10,0,10,4">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="{Binding Playback.DownloadStatus}" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontSize="11.5" Margin="0,0,10,0"/>
                        <Button Content="Cancelar" Style="{StaticResource GhostButton}" Padding="10,5"
                                Command="{Binding Playback.CancelDownloadCommand}"
                                Visibility="{Binding Playback.IsDownloading, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                                Command="{Binding Playback.PlaySelectionCommand}"
                                IsEnabled="{Binding Playback.HasSelection}"
                                Content="Reproducir tramo"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                                Command="{Binding Playback.DownloadCommand}"
                                IsEnabled="{Binding Playback.HasSelection}"
                                ToolTip="Guarda el tramo marcado del cuadro seleccionado como MP4 en la carpeta de grabaciones">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Exportar MP4"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tramo:" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Playback.SelectionText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontSize="11.5"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Style="{StaticResource GhostButton}" Padding="7,4" Margin="8,0,0,0"
                                Command="{Binding Playback.ClearSelectionCommand}"
                                Visibility="{Binding Playback.HasSelection, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                ToolTip="Borrar la marca"/>
                        <TextBlock Text="{Binding Playback.Status}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <!-- Línea de tiempo + densidad -->
                <DockPanel Margin="10,2,10,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource GhostButton}" Padding="8,5" Click="OnTimelineZoomOut"
                                ToolTip="Menos detalle (abarcar más horas)"/>
                        <TextBlock Text="{Binding ElementName=Timeline, Path=SpanLabel}" Width="50"
                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{StaticResource GhostButton}" Padding="8,5" Click="OnTimelineZoomIn"
                                ToolTip="Más detalle (acercar la línea de tiempo)"/>
                    </StackPanel>
                    <views:TimelineBar x:Name="Timeline" Height="70"
                                       Tracks="{Binding Playback.Tracks}"
                                       Day="{Binding Playback.Date}"
                                       Playhead="{Binding Playback.Playhead}"
                                       SelectionMode="{Binding Playback.IsSelectionMode}"
                                       SelectionStart="{Binding Playback.SelectionStart}"
                                       SelectionEnd="{Binding Playback.SelectionEnd}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Grilla de reproducción (un cuadro por canal, todos a la misma hora) -->
        <Grid Background="#06090D">
            <ItemsControl ItemsSource="{Binding Playback.Cells}" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <views:VideoLayoutPanel Layout="{Binding Playback.Layout}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlaybackCellViewModel}">
                        <!-- El video de FlyleafLib vive en una ventana nativa superpuesta:
                             los clics sobre él NO llegan a WPF, así que la barra del
                             cuadro selecciona/silencia/cierra y los dobles clics sobre
                             el video se enganchan en OnFlyleafHostLoaded (code-behind). -->
                        <Border Margin="3" Background="#0A0E13" CornerRadius="4" BorderThickness="2"
                                MouseLeftButtonDown="OnCellClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{x:Static vm:SelectedCellComparer.Instance}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.Playback.SelectedCell"
                                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Background="#151D26" Cursor="Hand">
                                    <Button DockPanel.Dock="Right" Content="&#x2715;" Command="{Binding CloseCommand}"
                                            Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                            BorderThickness="0" Padding="9,2" Cursor="Hand" FontSize="11"
                                            ToolTip="Quitar el canal de la reproducción"/>
                                    <!-- Captura y cápsula: mismas carpetas y avisos que la Vista en Vivo -->
                                    <Button DockPanel.Dock="Right" Command="{Binding SnapshotCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="8,2" Cursor="Hand"
                                            ToolTip="Guardar una captura del cuadro que se está viendo">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleRecordingCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="8,2" Cursor="Hand"
                                            ToolTip="Grabar una cápsula de lo que se está reproduciendo">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE7C8;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRecordingClip}" Value="True">
                                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding RecordingElapsed}" Margin="5,0,0,0" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleAudioCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="8,2" Cursor="Hand"
                                            ToolTip="Audio de este cuadro">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE74F;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudioOn}" Value="True">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource LoadingSpinner}"
                                             Margin="10,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Abriendo la grabación en el equipo…"
                                             Visibility="{Binding IsOpening,
                                                          Converter={x:Static vm:BoolToVisibility.Instance}}">
                                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Title}" Margin="10,4" FontSize="11.5"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Grid.Row="1" Background="#06090D" MouseLeftButtonDown="OnVideoAreaClick">
                                    <fl:FlyleafHost Player="{Binding Player}" AttachedDragMove="None"
                                                    KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                                    ToggleFullScreenOnDoubleClick="None"
                                                    Loaded="OnFlyleafHostLoaded"
                                                    Visibility="{Binding IsPlaying, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                               Foreground="#5A6674" FontSize="11.5"
                                               Visibility="{Binding IsPlaying, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Elija un canal (doble clic en el árbol) y luego haga clic en la línea de tiempo para reproducir."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="420" Foreground="#3A4654" FontSize="12.5"
                       Visibility="{Binding Playback.Cells.Count, Converter={x:Static vm:ZeroToVisibility.Instance}}"/>
        </Grid>
    </DockPanel>
</UserControl>
