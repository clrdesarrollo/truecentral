<UserControl x:Class="TrueCentralVms.Client.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             xmlns:views="clr-namespace:TrueCentralVms.Client.Views"
             xmlns:services="clr-namespace:TrueCentralVms.Client.Services"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Centro de mando: lista de recursos y cuadros que no son video -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/TrueCentralVms.Client;component/Views/CommandCenterTemplates.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- GhostToggle vive en App.xaml: lo comparte con Reproducción. -->

        <!-- Botón de cada división dentro del popup (miniatura + número) -->
        <Style x:Key="LayoutPresetButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- División activa: borde acento -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{x:Static vm:SelectedCellComparer.Instance}">
                            <Binding/>
                            <Binding Path="DataContext.CurrentLayout" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Interruptor Horizontal | Vertical del selector de divisiones: el
             monitorcito acostado o parado a cada lado y la perilla que corre. -->
        <Style x:Key="OrientationSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Landscape" Width="16" Height="11" BorderThickness="1.5" CornerRadius="1.5"
                                    BorderBrush="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LandscapeText" Text="Horizontal" FontSize="10.5" Margin="5,0,8,0"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Grid Width="32" Height="17" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="8.5" Background="{StaticResource Panel2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                <Ellipse x:Name="Knob" Width="11" Height="11" Margin="3,0" HorizontalAlignment="Left"
                                         Fill="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock x:Name="PortraitText" Text="Vertical" FontSize="10.5" Margin="8,0,5,0"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="Portrait" Width="11" Height="16" BorderThickness="1.5" CornerRadius="1.5"
                                    BorderBrush="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Landscape" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                                <Setter TargetName="LandscapeText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Setter TargetName="Portrait" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="PortraitText" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Miniatura de una división (rectángulos proporcionales) -->
        <DataTemplate x:Key="LayoutPreview">
            <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="0.8" Margin="0.8"/>
        </DataTemplate>

        <!-- Una división dentro del popup: miniatura + cantidad de cuadros -->
        <DataTemplate x:Key="LayoutPresetItem">
            <Button Style="{StaticResource LayoutPresetButton}" Click="OnLayoutPicked" ToolTip="{Binding Label}"
                    Command="{Binding DataContext.SelectLayoutCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Cells}"
                                  IsHitTestVisible="False" HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource LayoutPreview}">
                        <!-- Con las divisiones para monitor vertical, la miniatura va parada -->
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="Height" Value="26"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsVerticalLayouts,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Width" Value="22"/>
                                        <Setter Property="Height" Value="32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:VideoLayoutPanel Layout="{Binding}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Fila de una vista guardada dentro del desplegable -->
        <Style x:Key="SavedViewRow" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acciones de una vista (actualizar / eliminar): glifo sin marco -->
        <Style x:Key="SavedViewIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverStrongBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eliminar: igual, pero el hover avisa en rojo -->
        <Style x:Key="SavedViewDeleteButton" TargetType="Button" BasedOn="{StaticResource SavedViewIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chevron para minimizar/restaurar el panel PTZ -->
        <Style x:Key="PtzCollapseToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Content" Value="&#xE70D;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="8,2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content" Value="&#xE70E;"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <!-- Panel izquierdo: árbol de dispositivos + asa para colapsarlo -->
        <DockPanel DockPanel.Dock="Left"
                   Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
        <!-- Asa lateral (estilo vwcontroller): colapsa/expande la lista -->
        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsTreeCollapsed}" Focusable="False"
                      Cursor="Hand" ToolTip="Mostrar u ocultar la lista de dispositivos">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Width="14" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <TextBlock x:Name="Glyph" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE76C;"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <!-- Arbol de dispositivos -->
        <Border Width="250" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsTreeCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <DockPanel>
                <!-- Encabezado: la lista va por ubicación, como Recursos del panel web -->
                <DockPanel DockPanel.Dock="Top" Margin="14,9,10,8" MinHeight="24">
                    <TextBlock Text="RECURSOS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <!-- Buscador del árbol (filtra canales y equipos, sin tildes) -->
                <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="9,6" FontSize="12"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Buscar…" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- Panel PTZ: siempre presente, minimizado por defecto. Sus
                     controles se habilitan solo si el cuadro seleccionado
                     tiene cámara PTZ. También se maneja con el teclado:
                     flechas = pan/tilt, +/- = zoom, Shift = modo precisión. -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel>
                        <!-- Encabezado: siempre visible; el chevron minimiza el resto -->
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PtzCollapseToggle}"
                                          IsChecked="{Binding IsPtzExpanded}"
                                          ToolTip="Minimizar / restaurar el control PTZ"/>
                            <!-- Píldora del modo precisión (Shift sostenido) -->
                            <Border DockPanel.Dock="Right" CornerRadius="8" Background="{StaticResource AccentBrush}"
                                    Padding="7,2" Margin="6,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsPrecisionMode, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                    ToolTip="Modo precisión: movimiento PTZ a velocidad mínima (suelte Shift para salir)">
                                <TextBlock Text="PRECISIÓN" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <!-- Píldora del joystick PTZ (conectado y moviendo la cámara seleccionada) -->
                            <Border DockPanel.Dock="Right" CornerRadius="8" Background="{StaticResource AccentBrush}"
                                    Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsJoystickActive, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                    ToolTip="El joystick mueve la cámara PTZ seleccionada (Configuración → Joystick)">
                                <TextBlock Text="JOYSTICK" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                PTZ — <Run Text="{Binding PtzTargetName, Mode=OneWay}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPtzAvailable}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </DockPanel>
                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsPtzAvailable}"
                                    Visibility="{Binding IsPtzExpanded, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <!-- Sin el permiso "Mover cámaras PTZ" el panel queda deshabilitado, con el porqué -->
                        <TextBlock Margin="2,0,2,6" Text="Sus roles no incluyen mover cámaras PTZ." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding CanPtz, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                        <UniformGrid Columns="3" Rows="3" Width="132" HorizontalAlignment="Left">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Padding" Value="0,7"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPtzPress"/>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnPtzRelease"/>
                                    <EventSetter Event="MouseLeave" Handler="OnPtzLeave"/>
                                </Style>
                            </UniformGrid.Resources>
                            <Button Content="↖" Tag="UpLeft"/>
                            <Button Content="↑" Tag="TiltUp"/>
                            <Button Content="↗" Tag="UpRight"/>
                            <Button Content="←" Tag="PanLeft"/>
                            <Button Content="·" IsEnabled="False" Tag=""/>
                            <Button Content="→" Tag="PanRight"/>
                            <Button Content="↙" Tag="DownLeft"/>
                            <Button Content="↓" Tag="TiltDown"/>
                            <Button Content="↘" Tag="DownRight"/>
                        </UniformGrid>
                        <!-- Zoom / Foco / Iris: presionar mantiene el movimiento, soltar lo detiene -->
                        <Grid Margin="0,8,0,0">
                            <Grid.Resources>
                                <Style x:Key="PtzHoldButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Padding" Value="0,5"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPtzPress"/>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnPtzRelease"/>
                                    <EventSetter Event="MouseLeave" Handler="OnPtzLeave"/>
                                </Style>
                                <Style x:Key="PtzRowLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zoom" Style="{StaticResource PtzRowLabel}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="−" Tag="ZoomOut" Style="{StaticResource PtzHoldButton}"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="+" Tag="ZoomIn" Style="{StaticResource PtzHoldButton}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Foco" Style="{StaticResource PtzRowLabel}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Cerca" Tag="FocusNear" Style="{StaticResource PtzHoldButton}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Lejos" Tag="FocusFar" Style="{StaticResource PtzHoldButton}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Iris" Style="{StaticResource PtzRowLabel}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Abrir" Tag="IrisOpen" Style="{StaticResource PtzHoldButton}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Cerrar" Tag="IrisClose" Style="{StaticResource PtzHoldButton}"/>
                        </Grid>
                        <!-- Presets: ir / guardar posición actual / borrar -->
                        <DockPanel Margin="2,8,2,0">
                            <TextBlock DockPanel.Dock="Left" Text="Preset" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox DockPanel.Dock="Left" Width="38" Style="{StaticResource DarkTextBox}"
                                     Padding="4,4" FontSize="11.5" TextAlignment="Center"
                                     Text="{Binding PtzPresetIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Borrar" Tag="Clear" Click="OnPtzPreset" Margin="2,0,0,0"
                                    Style="{StaticResource GhostButton}" Padding="6,4" FontSize="10.5"
                                    ToolTip="Eliminar este preset en la cámara"/>
                            <Button Content="Guardar" Tag="Set" Click="OnPtzPreset" Margin="2,0"
                                    Style="{StaticResource GhostButton}" Padding="6,4" FontSize="10.5"
                                    ToolTip="Guardar la posición actual como este preset"/>
                            <Button Content="Ir" Tag="Goto" Click="OnPtzPreset" Margin="4,0,2,0"
                                    Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10.5"
                                    ToolTip="Mover la cámara a este preset"/>
                        </DockPanel>
                        <DockPanel Margin="2,8,2,0">
                            <TextBlock DockPanel.Dock="Left" Text="Velocidad" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PtzSpeed}" FontSize="11"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider Minimum="1" Maximum="7" Value="{Binding PtzSpeed}" IsSnapToTickEnabled="True"
                                    TickFrequency="1" VerticalAlignment="Center"/>
                        </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Panel Parlantes IP: hablar (mantener presionado), sonidos
                     del servidor, biblioteca del equipo y texto a voz. Con
                     varios parlantes marcados los sonidos del servidor suenan
                     sincronizados. Solo aparece si hay parlantes configurados y
                     sus roles incluyen "Usar parlantes". -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10"
                        DataContext="{Binding Speakers}"
                        Visibility="{Binding IsPanelVisible, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PtzCollapseToggle}"
                                          IsChecked="{Binding IsExpanded}"
                                          ToolTip="Minimizar / restaurar el panel de parlantes"/>
                            <!-- Marcar / desmarcar todos los parlantes -->
                            <Button DockPanel.Dock="Right" Padding="0" Width="26" Height="22"
                                    Margin="6,0,2,0" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding ToggleSelectAllCommand}"
                                    Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="&#xE8B3;"/>
                                        <Setter Property="ToolTip" Value="Marcar todos los parlantes"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllSelected}" Value="True">
                                                <Setter Property="Content" Value="&#xE8E6;"/>
                                                <Setter Property="ToolTip" Value="Desmarcar todos los parlantes"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                PARLANTES — <Run Text="{Binding SelectionSummary, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                            </TextBlock>
                        </DockPanel>
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibility.Instance}}">
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Speakers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource DarkCheckBox}"
                                                      IsEnabled="{Binding CanOperate}" ToolTipService.ShowOnDisabled="True"
                                                      Margin="0,1" ToolTip="{Binding Tooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                    <TextBlock Text="{Binding BusyWith}" FontSize="10" Margin="6,0,0,0"
                                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Volumen de salida de los parlantes marcados (se aplica al soltar) -->
                            <DockPanel Margin="0,8,0,0" ToolTip="Volumen de salida del parlante (0-100); con varios marcados se aplica a todos">
                                <TextBlock DockPanel.Dock="Left" Text="Volumen" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" FontSize="11" Width="26" TextAlignment="Right"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Volume}" IsEnabled="{Binding HasSelection}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- Micrófono: cuál usar y su nivel (modo prueba = captura sin transmitir) -->
                            <DockPanel Margin="0,8,0,0"
                                       Visibility="{Binding HasMicrophones, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <ToggleButton DockPanel.Dock="Right" Width="58" Height="28" Margin="4,0,0,0" FontSize="11"
                                              Style="{StaticResource GhostToggle}" IsChecked="{Binding IsMicTest}"
                                              Content="Probar"
                                              ToolTip="Captura el micrófono elegido sin transmitir: el nivel de abajo debe moverse al hablar"/>
                                <ComboBox Height="28" FontSize="11" ItemsSource="{Binding Microphones}"
                                          SelectedItem="{Binding SelectedMicrophone}"
                                          ToolTip="Micrófono con el que se habla por los parlantes (se recuerda)"/>
                            </DockPanel>
                            <Grid Margin="0,4,0,0" Height="8"
                                  Visibility="{Binding HasMicrophones, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                  ToolTip="Nivel del micrófono">
                                <Border Background="{StaticResource BgBrush}" CornerRadius="3"/>
                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                        Width="{Binding MicLevel, Converter={x:Static vm:PercentToWidth.Instance}, ConverterParameter=226}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource OkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MicLevel, Converter={x:Static vm:GreaterThan.Instance}, ConverterParameter=85}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <!-- Hablar: mantener presionado (press-and-hold, como el PTZ) -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasSelection}"
                                        PreviewMouseLeftButtonDown="OnTalkPress" PreviewMouseLeftButtonUp="OnTalkRelease"
                                        MouseLeave="OnTalkLeave"
                                        ToolTip="Mantenga presionado para hablar por los parlantes marcados (micrófono del equipo)">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mantener para hablar"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTalking}" Value="True">
                                                        <Setter Property="Text" Value="● Hablando… (suelte para terminar)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="1" Content="Detener" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding StopCommand}" IsEnabled="{Binding HasSelection}"
                                        ToolTip="Detener lo que esté sonando en los parlantes marcados"/>
                            </Grid>
                            <CheckBox Margin="0,6,0,0" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding TalkPreTone}"
                                      Content="Tono al abrir el canal (dos pitidos antes de la voz)" FontSize="11"
                                      ToolTip="Como el aviso de canal listo de una radio: confirma que los parlantes ya están escuchando"/>
                            <!-- Sonido del servidor (sincronizado entre los marcados) -->
                            <DockPanel Margin="0,6,0,0"
                                       Visibility="{Binding HasSounds, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <Button DockPanel.Dock="Right" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="0" Width="30" Height="28" Margin="4,0,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding PlaySoundCommand}" IsEnabled="{Binding HasSelection}"
                                        ToolTip="Reproducir el sonido del servidor en los PARLANTES marcados (sincronizado)"/>
                                <Button DockPanel.Dock="Right" Content="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" Width="30" Height="28" Margin="4,0,0,0"
                                        Style="{StaticResource GhostButton}" Command="{Binding PreviewSoundCommand}"
                                        ToolTip="Escuchar en ESTE equipo (no suena en los parlantes); otro clic detiene"/>
                                <ComboBox Height="28" FontSize="11" ItemsSource="{Binding ServerSounds}" DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedSound}" ToolTip="Sonidos subidos al servidor (Automatizaciones → Sonidos)"/>
                            </DockPanel>
                            <!-- Biblioteca del propio parlante -->
                            <DockPanel Margin="0,6,0,0"
                                       Visibility="{Binding HasLibrary, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <Button DockPanel.Dock="Right" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="0" Width="30" Height="28" Margin="4,0,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding PlayLibraryCommand}" IsEnabled="{Binding HasSelection}"
                                        ToolTip="Reproducir el audio guardado en el PARLANTE (se busca por nombre en cada uno)"/>
                                <Button DockPanel.Dock="Right" Content="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" Width="30" Height="28" Margin="4,0,0,0"
                                        Style="{StaticResource GhostButton}" Command="{Binding PreviewLibraryCommand}"
                                        ToolTip="Escuchar en ESTE equipo (se descarga del parlante, no suena afuera); otro clic detiene"/>
                                <Button DockPanel.Dock="Right" Content="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" Width="30" Height="28"
                                        Margin="4,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding DownloadLibraryCommand}"
                                        ToolTip="Descargar el archivo desde el parlante a este equipo"/>
                                <ComboBox Height="28" FontSize="11" ItemsSource="{Binding Library}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedLibraryItem}" ToolTip="{Binding LibraryOwner}"/>
                            </DockPanel>
                            <!-- Texto a voz generado por el parlante -->
                            <DockPanel Margin="0,6,0,0"
                                       Visibility="{Binding HasTts, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <Button DockPanel.Dock="Right" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="0" Width="30" Height="28" Margin="4,0,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding PlayTtsCommand}" IsEnabled="{Binding HasSelection}"
                                        ToolTip="El parlante lee el texto en voz alta"/>
                                <Grid>
                                    <TextBox x:Name="TtsBox" Style="{StaticResource DarkTextBox}" Padding="8,4" FontSize="11" MaxLength="100"
                                             Text="{Binding TtsText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Texto a leer (máximo 100 caracteres)"/>
                                    <TextBlock Text="Texto a leer en voz alta…" IsHitTestVisible="False" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TtsBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TreeView x:Name="DeviceTree" ItemsSource="{Binding TreeItems}"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                          MouseDoubleClick="OnTreeDoubleClick"
                          PreviewMouseLeftButtonDown="OnTreeMouseDown"
                          PreviewMouseMove="OnTreeMouseMove"
                          ContextMenuOpening="OnTreeContextMenuOpening"
                          TreeViewItem.Selected="OnTreeItemSelected">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <!-- Buscador: los nodos filtrados se ocultan -->
                            <Setter Property="Visibility"
                                    Value="{Binding IsVisible, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                            <!-- Selección bidireccional: clic del usuario y también
                                 desde el ViewModel (cuadro seleccionado → canal) -->
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceNode}" ItemsSource="{Binding Channels}">
                            <StackPanel Orientation="Horizontal" Margin="0,2"
                                        ToolTip="Doble clic para abrir todos sus canales">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <!-- Ubicación (árbol por ubicación): doble clic abre todas sus cámaras -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:LocationNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding ToolTipText}">
                                <!-- Órdenes sobre la ubicación entera (con sus sububicaciones) -->
                                <StackPanel.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <MenuItem Header="Abrir sus cámaras" Click="OnLocationOpenCameras"/>
                                        <MenuItem Header="Vigilar esta ubicación en el cuadro seleccionado" Click="OnLocationWatch"
                                                  ToolTip="Un Cuadro vigía que cambia solo a la cámara de los eventos de esta ubicación"
                                                  Visibility="{Binding IsRealLocation, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        <!-- "Sin ubicación" y sus equipos no son ubicaciones: sin órdenes -->
                                        <Separator Visibility="{Binding IsRealLocation, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        <MenuItem Header="Armar total sus áreas de alarma…" Click="OnLocationArmAway"
                                                  IsEnabled="{Binding CanCommand}" ToolTip="{Binding CommandHint}"
                                                  ToolTipService.ShowOnDisabled="True" Visibility="{Binding IsRealLocation, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        <MenuItem Header="Armar parcial sus áreas de alarma…" Click="OnLocationArmStay"
                                                  IsEnabled="{Binding CanCommand}" ToolTip="{Binding CommandHint}"
                                                  ToolTipService.ShowOnDisabled="True" Visibility="{Binding IsRealLocation, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        <MenuItem Header="Desarmar sus áreas de alarma…" Click="OnLocationDisarm"
                                                  IsEnabled="{Binding CanCommand}" ToolTip="{Binding CommandHint}"
                                                  ToolTipService.ShowOnDisabled="True" Visibility="{Binding IsRealLocation, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelNode}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <!-- Dice de qué equipo es: por ubicación se mezclan cámaras de varios -->
                                        <Setter Property="ToolTip" Value="{Binding TreeToolTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="ToolTip" Value="{Binding LiveLocation}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- ◉ = canal; ▶ = está en un cuadro de la vista en vivo
                                     (estilo HikCentral). El color sigue siendo el estado:
                                     verde en línea, gris sin señal. -->
                                <TextBlock Width="11" Margin="0,0,5,0" VerticalAlignment="Center" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="◉"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Text" Value="▶"/>
                                                    <Setter Property="FontSize" Value="9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Header}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
        </DockPanel>

        <!-- Barra de herramientas del módulo: división de la grilla. En la
             apariencia Consola baja y se centra como botonera flotante (en su
             propia fila: el video taparía cualquier cosa encima de la grilla). -->
        <Border DockPanel.Dock="{x:Static services:ClientTheme.LiveToolbarDock}"
                HorizontalAlignment="{x:Static services:ClientTheme.LiveToolbarAlignment}"
                Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}"
                Visibility="{Binding IsGridFullscreen, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static services:ClientTheme.IsConsole}}" Value="True">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="Margin" Value="0,2,0,10"/>
                            <Setter Property="Padding" Value="8,7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static services:ClientTheme.LiveToolbarSideColumn}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{x:Static services:ClientTheme.LiveToolbarSideColumn}"/>
            </Grid.ColumnDefinitions>
            <!-- Los tres grupos comparten la misma celda: el de la izquierda y
                 el de la derecha se anclan a su borde y "Vistas" queda centrado
                 respecto de la barra completa, sobre la grilla de cámaras. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- (El botón «Pantalla auxiliar» se reemplazó por extraer la viñeta del
                 Centro de mando a su propia ventana, como en un navegador: MainWindow.Tabs.) -->
            <!-- Pantalla completa del área de la grilla (Esc para salir) -->
            <Button Style="{StaticResource GhostButton}" Padding="10,5"
                    Command="{Binding EnterGridFullscreenCommand}"
                    ToolTip="Pantalla completa de la grilla — presione Esc para salir">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Pantalla completa" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="División:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <!-- Selector de división estilo iVMS-4200: botón con la
                     miniatura actual; el popup lista todas las divisiones. -->
                <ToggleButton x:Name="LayoutPickerToggle" Style="{StaticResource GhostToggle}" Margin="0,0,6,0"
                              ToolTip="{Binding CurrentLayout.Label}" Checked="OnLayoutPickerOpened">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding CurrentLayout.Cells}" Width="24" Height="17"
                                      IsHitTestVisible="False" ItemTemplate="{StaticResource LayoutPreview}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:VideoLayoutPanel Layout="{Binding CurrentLayout}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding CurrentLayout.Name}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=LayoutPickerToggle}" Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=LayoutPickerToggle}" StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,8,8">
                        <StackPanel>
                            <!-- Arriba a la derecha: divisiones para monitor horizontal o vertical -->
                            <DockPanel Margin="2,0,2,8">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource OrientationSwitch}"
                                              IsChecked="{Binding IsVerticalLayouts, Mode=TwoWay}"
                                              ToolTip="Divisiones para monitor horizontal (apagado) o vertical (encendido)"/>
                                <TextBlock Text="División de pantalla" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- Una fila por familia; 7 columnas fijas para que las
                                 miniaturas queden alineadas entre familias. -->
                            <ItemsControl ItemsSource="{Binding LayoutGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}" FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}" Margin="4,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Layouts}"
                                                          ItemTemplate="{StaticResource LayoutPresetItem}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
                <!-- Zoom digital: recorta la imagen ya recibida (no mueve la cámara) -->
                <ToggleButton Style="{StaticResource GhostToggle}" Padding="10,5" Margin="0,0,6,0"
                              IsChecked="{Binding IsDigitalZoomMode, Mode=TwoWay}"
                              Checked="OnDigitalZoomToggled" Unchecked="OnDigitalZoomToggled"
                              ToolTip="Zoom digital: arrastre sobre el video para marcar el área a acercar (clic derecho vuelve a 1×)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Zoom" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <!-- Unir cuadros: arrastrar de un cuadro a otro los une en uno; clic en uno unido lo separa -->
                <ToggleButton Style="{StaticResource GhostToggle}" Padding="10,5" Margin="0,0,6,0"
                              IsChecked="{Binding IsMergeMode, Mode=TwoWay}" Unchecked="OnMergeModeOff"
                              ToolTip="Unir cuadros: arrastre de un cuadro a otro para unir el rectángulo en uno solo; un clic en un cuadro unido lo separa">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Unir" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button Content="Limpiar todo" Style="{StaticResource GhostButton}" Padding="12,5"
                        Command="{Binding ClearAllCommand}"/>
                <!-- Indicador de apertura masiva (va en la barra porque el video
                     de Flyleaf taparía cualquier overlay sobre la grilla) -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding IsBulkOpening, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="5" VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource Panel2Brush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding BulkOpeningText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>

            <!-- Tableros: al centro de la barra, porque es a lo que más se vuelve
                 en un turno. Cada uno recuerda la división y qué había en cada
                 cuadro (cámara, recurso, tarjeta o página web). -->
            <Grid Grid.Column="1" Margin="{x:Static services:ClientTheme.LiveToolbarGroupGap}">
                <ToggleButton x:Name="ViewsToggle" Style="{StaticResource GhostToggle}" Padding="14,5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding IsViewsPopupOpen, Mode=TwoWay}"
                              ToolTip="Tableros: deje la grilla como la armó y vuelva a ella con un clic">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tableros" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        <!-- Último tablero cargado: el operador sabe en qué está parado -->
                        <TextBlock Text="{Binding ActiveViewName}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding ActiveViewName,
                                                Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=ViewsToggle}" Placement="Bottom"
                       IsOpen="{Binding IsViewsPopupOpen, Mode=TwoWay}" StaysOpen="False"
                       AllowsTransparency="True" Focusable="True">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,8,8" Width="380">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="TABLEROS" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       Margin="2,0,0,8"/>

                            <!-- Guardar la grilla que hay ahora (solo con "Crear tableros propios") -->
                            <StackPanel DockPanel.Dock="Bottom">
                                <StackPanel Visibility="{Binding CanSaveViews, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,10"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Guardar" Padding="12,5" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveCurrentViewCommand}"
                                            ToolTip="Guarda la división y lo que hay ahora en cada cuadro"/>
                                    <Grid>
                                        <TextBox x:Name="ViewNameBox" Style="{StaticResource DarkTextBox}"
                                                 Padding="9,6" FontSize="12"
                                                 Text="{Binding NewViewName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Nombre del tablero…" IsHitTestVisible="False"
                                                   Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ViewNameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <!-- Solo quien administra los compartidos; los roles se eligen en el panel web -->
                                <CheckBox Content="Compartir con todos (los roles se eligen en el panel web)" Margin="2,8,0,0" FontSize="12"
                                          Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding NewViewShared, Mode=TwoWay}"
                                          Visibility="{Binding CanShareViews, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SavedViewsStatus}" Margin="2,8,0,0" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Visibility="{Binding SavedViewsStatus,
                                                        Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
                            </StackPanel>

                            <!-- Lista de tableros (compartidos primero): el clic en la fila lo carga en la grilla -->
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SavedViews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Button Style="{StaticResource SavedViewRow}"
                                                        Command="{Binding DataContext.ApplySavedViewCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Cargar este tablero en la grilla">
                                                    <StackPanel Margin="0,0,60,0">
                                                        <DockPanel>
                                                            <!-- Candado: compartido, se usa tal cual -->
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       ToolTip="Tablero compartido: solo lo cambia quien administra los tableros"
                                                                       Visibility="{Binding Locked, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- Actualizar / eliminar: los propios, y los compartidos
                                                     solo para quien los administra -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Visibility="{Binding CanEdit,
                                                                         Converter={x:Static vm:BoolToVisibility.Instance}}">
                                                    <Button Style="{StaticResource SavedViewIconButton}"
                                                            Content="&#xE74E;"
                                                            Command="{Binding DataContext.UpdateSavedViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Actualizar este tablero con la grilla actual"/>
                                                    <Button Style="{StaticResource SavedViewDeleteButton}"
                                                            Content="&#xE74D;" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.DeleteSavedViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Eliminar este tablero"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
            </Grid>
        </Border>

        <!-- Grilla de video -->
        <!-- Ampliar la grilla: una cámara llevada a un borde abre ahí la franja
             nueva (la dibuja GridGrowOverlay, encima de la grilla y fuera del video). -->
        <Grid x:Name="GridHost" Background="Transparent" AllowDrop="True"
              DragOver="OnGridHostDragOver" DragLeave="OnGridHostDragLeave" Drop="OnGridHostDrop">
        <ItemsControl ItemsSource="{Binding Cells}" Margin="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <views:VideoLayoutPanel Layout="{Binding CurrentLayout}"
                                            MaximizedIndex="{Binding MaximizedIndex}"
                                            Loaded="OnGridPanelLoaded"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:VideoCellViewModel}">
                    <!-- El video de FlyleafLib vive en una ventana nativa superpuesta:
                         los clics sobre el video NO llegan a WPF. Por eso cada cuadro
                         tiene su propia barra (siempre WPF y clickeable) para
                         seleccionarlo, y el cuerpo solo es clickeable cuando está vacío. -->
                    <!-- Selección: cualquier clic adentro (barra, video, tarjeta, página web) o el
                         foco del teclado en algo del cuadro lo deja seleccionado (OnCellPreviewDown,
                         OnCellFocused); el clic ya no lo deselecciona (Esc sí). -->
                    <Border Margin="0.5" Background="{StaticResource CellBgBrush}" CornerRadius="2"
                            PreviewMouseLeftButtonDown="OnCellPreviewDown"
                            Keyboard.GotKeyboardFocus="OnCellFocused"
                            MouseLeftButtonDown="OnCellClick"
                            MouseMove="OnCellMouseMove"
                            AllowDrop="True" Drop="OnCellDrop"
                            DragOver="OnCellDragOver" DragLeave="OnCellDragLeave">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <!-- En el estilo y no en el elemento: la selección y «Unir» lo engruesan -->
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <!-- El DataContext de la ventana es el del Centro de mando también
                                         cuando la pestaña se extrajo a su propia ventana -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{x:Static vm:SelectedCellComparer.Instance}">
                                                <Binding/>
                                                <Binding Path="DataContext.SelectedCell" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <!-- Destino del arrastre en curso: dónde va a caer la cámara -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{x:Static vm:SelectedCellComparer.Instance}">
                                                <Binding/>
                                                <Binding Path="DataContext.DropTargetCell" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="#FCD34D"/>
                                    </DataTrigger>
                                    <!-- Selección de «Unir cuadros»: se une (acento) o la selección lo corta (rojo) -->
                                    <DataTrigger Binding="{Binding MergeMark}" Value="1">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MergeMark}" Value="2">
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Barra del cuadro: número, título, estado y cerrar -->
                            <DockPanel Grid.Row="0" Background="{StaticResource CellBarBrush}" Cursor="Hand">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="ToolTip"
                                                Value="Arrastre este cuadro sobre otro para cambiar la cámara de ubicación (si el otro tiene video, se intercambian)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <Border DockPanel.Dock="Left" Background="{StaticResource Panel2Brush}"
                                        CornerRadius="4" Margin="5,3" Padding="6,1"
                                        Visibility="{x:Static services:ClientTheme.ClassicOnly}">
                                    <TextBlock Text="{Binding Index}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <!-- Consola: rótulo del cuadro en mayúsculas y acento -->
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat=CARD {0:00}}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"
                                           FontStretch="SemiCondensed" VerticalAlignment="Center" Margin="8,3,6,3"
                                           Visibility="{x:Static services:ClientTheme.ConsoleOnly}"/>
                                <Button DockPanel.Dock="Right" Content="&#x2715;" Command="{Binding ClearCommand}"
                                        Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                        BorderThickness="0" Padding="9,2" Cursor="Hand" FontSize="11"
                                        Visibility="{Binding IsEmpty, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                                <!-- Subdividir el card: pasa a ser 2, 4 o 9 cuadros para poner más cámaras -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource CellBarIconButton}" Content="&#xE71D;"
                                        Click="OnSubdivideClick"
                                        ToolTip="Subdividir este card para poner más de una cámara">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenu}">
                                            <MenuItem Header="En 2, lado a lado" Tag="2x1" Click="OnSubdividePicked"/>
                                            <MenuItem Header="En 2, uno sobre otro" Tag="1x2" Click="OnSubdividePicked"/>
                                            <MenuItem Header="En 3, lado a lado" Tag="3x1" Click="OnSubdividePicked"/>
                                            <MenuItem Header="En 4 (2 × 2)" Tag="2x2" Click="OnSubdividePicked"/>
                                            <MenuItem Header="En 6 (3 × 2)" Tag="3x2" Click="OnSubdividePicked"/>
                                            <MenuItem Header="En 9 (3 × 3)" Tag="3x3" Click="OnSubdividePicked"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <!-- Configurar la tarjeta (las cámaras de «Últimas patentes», por ejemplo) -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource CellBarIconButton}" Content="&#xE713;"
                                        Command="{Binding Panel.ConfigureCommand}"
                                        ToolTip="{Binding Panel.ConfigureHint}"
                                        Visibility="{Binding Panel.CanConfigure, Converter={x:Static vm:BoolToVisibility.Instance},
                                                     FallbackValue=Collapsed}"/>
                                <!-- Contador de la cápsula en curso (00:12) -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RecordingElapsed}"
                                           Foreground="{StaticResource DangerBrush}" FontSize="10.5"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"
                                           Visibility="{Binding IsRecordingClip, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                <!-- Grabación de cápsula local: ● rojo mientras graba -->
                                <Button DockPanel.Dock="Right" Command="{Binding ToggleRecordingCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                        Focusable="False" Content="&#x25CF;" FontSize="10"
                                        Visibility="{Binding HasVideo, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter Property="ToolTip" Value="Grabar una cápsula de video local (clic para iniciar)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordingClip}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="ToolTip" Value="Grabando… (clic para detener y guardar)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Captura de imagen del cuadro actual -->
                                <Button DockPanel.Dock="Right" Command="{Binding SnapshotCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                        Focusable="False" Content="&#xE722;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                                        Foreground="{StaticResource MutedBrush}"
                                        ToolTip="Guardar una captura de imagen de este cuadro"
                                        Visibility="{Binding HasVideo, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                <!-- Stream del cuadro: P = principal, S = secundario (clic alterna).
                                     Va en la barra porque el video de Flyleaf se traga los clics. -->
                                <Button DockPanel.Dock="Right" Command="{Binding SwitchProfileCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                        Focusable="False" FontSize="10" FontWeight="Bold"
                                        Visibility="{Binding HasVideo, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="P"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="ToolTip" Value="Stream principal (máxima calidad) — clic para cambiar al secundario"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profile}" Value="Sub">
                                                    <Setter Property="Content" Value="S"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Setter Property="ToolTip" Value="Stream secundario (liviano) — clic para cambiar al principal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Audio del cuadro (exclusivo: encenderlo silencia los demás) -->
                                <Button DockPanel.Dock="Right" Command="{Binding ToggleAudioCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                        Focusable="False"
                                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                                        ToolTip="Audio de este cuadro (se silencia el resto)"
                                        Visibility="{Binding HasVideo, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAudioOn}" Value="True">
                                                    <Setter Property="Content" Value="&#xE767;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Consola: resolución que entrega la cámara -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TelemetryResolution}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="6,0,4,0"
                                           Visibility="{x:Static services:ClientTheme.ConsoleOnly}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#FCD34D"
                                           FontSize="10.5" Margin="6,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                <Ellipse Style="{StaticResource LoadingSpinner}" Width="11" Height="11"
                                         Margin="4,0,0,0" VerticalAlignment="Center"
                                         ToolTip="Conectando con la cámara…"
                                         Visibility="{Binding IsConnecting,
                                                      Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                           Margin="4,3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Text" Value="Cuadro libre"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <!-- Cuerpo: video (o estado vacío clickeable) -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- El video se pinta en ventanas WPF propias de FlyleafLib
                                     ("Surface"/"Overlay") superpuestas al árbol normal: un clic ahí
                                     jamás llega a este template. La selección con clic sobre el video
                                     se engancha en OnFlyleafHostLoaded (ver code-behind). -->
                                <fl:FlyleafHost Player="{Binding Player}" AttachedDragMove="None"
                                                KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                                ToggleFullScreenOnDoubleClick="None"
                                                Loaded="OnFlyleafHostLoaded"
                                                Visibility="{Binding HasVideo, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <fl:FlyleafHost.Style>
                                        <!-- Con un panel que convive con el video (el Cuadro vigía) el video
                                             va debajo de su franja; si no, ocupa todo el cuerpo. -->
                                        <Style TargetType="fl:FlyleafHost">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Setter Property="Grid.RowSpan" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Panel.KeepsVideo, FallbackValue=False}" Value="True">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fl:FlyleafHost.Style>
                                </fl:FlyleafHost>
                                <!-- Contenido que no es video (puerta, panel, cerco, tarjeta, página web):
                                     cada tipo trae su DataTemplate en Views/CellPanelTemplates.xaml. -->
                                <ContentControl Content="{Binding Panel}" Focusable="False"
                                                Visibility="{Binding HasPanel, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Grid.RowSpan" Value="2"/>
                                            <Style.Triggers>
                                                <!-- Solo mientras muestra video: en espera, el panel ocupa el cuadro entero -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Panel.KeepsVideo, FallbackValue=False}" Value="True"/>
                                                        <Condition Binding="{Binding HasVideo}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <TextBlock Text="Clic para seleccionar este cuadro y doble clic en un canal" Grid.RowSpan="2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource FaintTextBrush}" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="14"
                                           Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                            </Grid>
                            <!-- Consola: telemetría del cuadro (la refresca CellTelemetryTicker
                                 cada segundo). Fila propia bajo el video. -->
                            <DockPanel Grid.Row="2" Background="{StaticResource CellBarBrush}">
                                <!-- Solo con video: un cuadro de puerta, alarma… no tiene telemetría -->
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="{x:Static services:ClientTheme.ConsoleOnly}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPanel}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TelemetryUptime}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{StaticResource OkBrush}" Margin="8,3"/>
                                <TextBlock Text="{Binding TelemetryText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="8,3"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Canvas x:Name="GridGrowOverlay" ClipToBounds="True"/>
        </Grid>
    </DockPanel>
</UserControl>
