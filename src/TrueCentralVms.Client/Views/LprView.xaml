<UserControl x:Class="TrueCentralVms.Client.Views.LprView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrueCentralVms.Client.ViewModels"
             Background="{StaticResource BgBrush}">
    <!-- Misma disposición que la página ANPR del panel web (wwwroot\anpr.js):
         filtros con su etiqueta arriba, lista de lecturas a la izquierda y la
         ficha a la derecha, con la patente en verde sobre negro. -->
    <UserControl.Resources>
        <!-- Patentes en Consolas, como la web: la Cascadia Mono de Windows 11 es
             variable y WPF no le saca la negrita (cae en una sin serifa). -->
        <FontFamily x:Key="PlateFont">Consolas, Cascadia Mono</FontFamily>

        <!-- Etiqueta y valor de la ficha de detalle (en dos columnas, como en la web) -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bad}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ejemplo dentro del campo vacío (Tag = el texto del campo) -->
        <Style x:Key="FieldPlaceholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Fila de la lista de lecturas -->
        <Style x:Key="PlateListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hover" Background="Transparent"/>
                            <!-- Fila elegida: el acento tenue de fondo y la barra a la
                                 izquierda (la misma marca que la web). -->
                            <Rectangle x:Name="Tint" Fill="{StaticResource AccentBrush}" Opacity="0"/>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <ContentPresenter/>
                            </Border>
                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.14"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Patente leída: pantalla negra con letras verdes (estilo terminal),
             roja si no es una PPU chilena válida; clic = copiar. -->
        <Style x:Key="PlateBigButton" TargetType="Button">
            <Setter Property="Foreground" Value="#39FF14"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource PlateFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#000000" CornerRadius="5" Padding="18,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InvalidChile}" Value="True">
                    <Setter Property="Foreground" Value="#FF3B30"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta de la lista y de la ficha -->
        <Style x:Key="LprCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Título, fuentes y filtros ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10,16,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE804;" FontSize="16"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Reconocimiento de patentes" FontSize="15" FontWeight="SemiBold"
                                   Margin="10,0,20,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Fuentes"
                            Height="28" Padding="12,0" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ToggleSourcesPanelCommand}"
                            ToolTip="Elegir qué cámaras entregan patentes"/>

                    <!-- Fuentes encendidas con su semáforo (verde = recibiendo lecturas) -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,3" BorderThickness="1"
                                BorderBrush="{StaticResource WarnBrush}"
                                ToolTip="Active una cámara como fuente en “Fuentes”"
                                Visibility="{Binding HasNoActiveSources, Converter={x:Static vm:BoolToVisibility.Instance}}">
                            <TextBlock Text="Sin cámaras activas como fuente" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SourceChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Right"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,3" Margin="6,2,0,2" BorderThickness="1"
                                            Background="{StaticResource Panel2Brush}"
                                            BorderBrush="{StaticResource BorderBrush}" ToolTip="{Binding Hint}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Live}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>

                <!-- Filtros: cada campo con su etiqueta arriba -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Equipo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" Height="32" FontSize="12"
                                  ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding DeviceFilter}"
                                  ToolTip="Filtrar por equipo">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Patente" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="PlateBox" Style="{StaticResource FilterTextBox}"
                                     Text="{Binding PlateFilter, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnFilterKeyDown"
                                     ToolTip="Búsqueda parcial: “bb12” encuentra “BBBB12”"/>
                            <TextBlock Text="parcial, ej. BB12" Style="{StaticResource FieldPlaceholder}"
                                       Tag="{Binding Text, ElementName=PlateBox}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Desde (hora del equipo)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="FromBox" Style="{StaticResource FilterTextBox}"
                                     Text="{Binding FromFilter, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnFilterKeyDown"
                                     ToolTip="dd-mm-aaaa hh:mm, o solo la fecha (desde las 00:00)"/>
                            <TextBlock Text="dd-mm-aaaa hh:mm" Style="{StaticResource FieldPlaceholder}"
                                       Tag="{Binding Text, ElementName=FromBox}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Hasta (hora del equipo)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="ToBox" Style="{StaticResource FilterTextBox}"
                                     Text="{Binding ToFilter, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnFilterKeyDown"
                                     ToolTip="dd-mm-aaaa hh:mm, o solo la fecha (hasta las 23:59:59)"/>
                            <TextBlock Text="dd-mm-aaaa hh:mm" Style="{StaticResource FieldPlaceholder}"
                                       Tag="{Binding Text, ElementName=ToBox}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Mostrar" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" Height="32" FontSize="12"
                                  ItemsSource="{Binding TakeOptions}" SelectedItem="{Binding Take}"
                                  ToolTip="Cuántas lecturas traer (las más recientes)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButton}" Content="Buscar"
                                Height="32" Padding="16,0"
                                Command="{Binding SearchCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Limpiar" Margin="6,0,0,0"
                                Height="32" Padding="14,0" ToolTip="Quita todos los filtros"
                                Command="{Binding ClearFiltersCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Panel de fuentes (desplegable) ===== -->
        <Border Grid.Row="1" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10"
                Visibility="{Binding IsSourcesPanelOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
            <StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="Equipos del inventario capaces de entregar patentes. Al encender uno, el servidor le abre el canal de eventos y las lecturas empiezan a llegar solas."/>
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10,7"
                                    Margin="0,0,0,5">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Click="OnSourceToggleClick" VerticalAlignment="Center" Margin="0,0,10,0"
                                              IsEnabled="{Binding DataContext.IsAdmin,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ToolTip="Encender o apagar este equipo como fuente (requiere administrador)"/>
                                    <!-- Semáforo del canal de eventos: verde solo si el
                                         servidor lo tiene realmente abierto ahora mismo. -->
                                    <Ellipse DockPanel.Dock="Right" Width="9" Height="9" VerticalAlignment="Center"
                                             Margin="10,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                                <Setter Property="ToolTip" Value="Canal de eventos cerrado"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Live}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                        <Setter Property="ToolTip" Value="Recibiendo eventos del equipo"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0"
                                               Text="{Binding EventCount, StringFormat={}{0} lectura(s)}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Host}" FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding LastError}" FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"
                                                   Visibility="{Binding LastError,
                                                                Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Aviso / estado del módulo ===== -->
        <Border Grid.Row="2" Background="#1A3B82F6" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,7"
                Visibility="{Binding StatusMessage, Converter={x:Static vm:NonEmptyToVisibility.Instance}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}" FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===== Lista + ficha de detalle ===== -->
        <Grid Grid.Row="3" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="240"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Lecturas -->
            <Border Grid.Column="0" Style="{StaticResource LprCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource DarkCheckBox}"
                                      Content="Seguir en vivo" IsChecked="{Binding FollowLive}"
                                      VerticalAlignment="Center"
                                      ToolTip="Seleccionar automáticamente cada lectura nueva"/>
                            <TextBlock Text="{Binding CountText}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Margin="14,20,14,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Aún no hay lecturas. Cuando pase un vehículo frente a una cámara encendida, su patente aparecerá aquí al instante."
                               Visibility="{Binding Events.Count, Converter={x:Static vm:ZeroToVisibility.Instance}}"/>

                    <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             ItemContainerStyle="{StaticResource PlateListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- Miniatura: primer plano de la placa (o la escena si no vino) -->
                                    <Border DockPanel.Dock="Left" Width="86" Height="42" CornerRadius="4"
                                            Background="{StaticResource BgBrush}" Margin="0,0,10,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="Sin foto" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding MissingPhoto,
                                                                    Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConfidenceText}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding PlateNumber}" FontSize="15" FontWeight="Bold"
                                                       FontFamily="{StaticResource PlateFont}"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TimeText}" FontSize="12"/>
                                        <!-- La cámara en su propia línea: la lista queda más angosta
                                             y la escena de la ficha gana ese ancho. -->
                                        <TextBlock Text="{Binding SourceText}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding VehicleSummary}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding VehicleSummary,
                                                                Converter={x:Static vm:NonEmptyToVisibility.Instance}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent"
                          ToolTip="Arrastre para cambiar el ancho de la lista"/>

            <!-- Ficha de la lectura seleccionada -->
            <Border Grid.Column="2" Style="{StaticResource LprCard}">
                <Grid>
                    <TextBlock Text="Seleccione una lectura para ver el detalle."
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Selected, Converter={x:Static vm:NullToVisibility.Instance}}"/>

                    <!-- La visibilidad se ata al Selected del ViewModel, NO al
                         DataContext propio: con DataContext nulo el enlace queda
                         sin origen y WPF usaría el valor por omisión (visible). -->
                    <Grid DataContext="{Binding Selected}" Margin="16,14"
                          Visibility="{Binding DataContext.Selected,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       Converter={x:Static vm:NotNullToVisibility.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <!-- Escena capturada, con el recuadro que marcó la cámara -->
                        <Grid Grid.Column="0" x:Name="SceneHost">
                            <TextBlock Text="El equipo no envió la foto de la escena."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Visibility="{Binding MissingSceneImage,
                                                    Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Image x:Name="SceneImageElement" Source="{Binding SceneImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SizeChanged="OnSceneSizeChanged"/>
                                <!-- El recuadro se posiciona en código: depende del
                                     tamaño REAL con que se pintó la imagen. -->
                                <Canvas x:Name="SceneOverlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <!-- Primer plano de la placa, la patente leída y todo lo que informó el equipo -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="6,8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        MinHeight="70" Margin="0,0,0,12">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding PlateImage}" Stretch="Uniform" MaxHeight="110"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding PlateImage,
                                                            Converter={x:Static vm:NotNullToVisibility.Instance}}"/>
                                        <TextBlock Text="Sin primer plano de la placa" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding MissingPlateImage,
                                                                Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                        <Button Style="{StaticResource PlateBigButton}" Margin="0,6,0,0"
                                                Content="{Binding PlateNumber}" ToolTip="{Binding PlateHint}"
                                                Command="{Binding DataContext.CopyPlateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource DetailLabel}"
                                                           ToolTip="{Binding Hint}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource DetailValue}"
                                                           Visibility="{Binding Chars, Converter={x:Static vm:NullToVisibility.Instance}}"/>
                                                <!-- Confianza por carácter: cada letra con su % debajo
                                                     (en una línea, en vez de tres de texto). -->
                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Chars}" ToolTip="{Binding Hint}"
                                                              Visibility="{Binding Chars, Converter={x:Static vm:NotNullToVisibility.Instance}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel MinWidth="19" Margin="0,0,3,2">
                                                                <TextBlock Text="{Binding Char}" FontSize="13" FontWeight="Bold"
                                                                           FontFamily="{StaticResource PlateFont}"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextBrush}"/>
                                                                <TextBlock Text="{Binding Percent}" FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource MutedBrush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButton}" Margin="0,16,0,0" Height="34"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Fotos de la lectura y un JSON con todos sus datos, en la carpeta de capturas"
                                        Command="{Binding DataContext.DownloadZipCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Descargar ZIP" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
