<Window x:Class="TrueCentralVms.Client.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <!-- Notificación flotante (esquina inferior derecha del shell). Es una
         ventana propia y no un overlay del árbol visual porque el video de
         FlyleafLib vive en ventanas superpuestas que taparían cualquier
         elemento WPF de la ventana principal. -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="14,10" MaxWidth="440" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="&#x2715;" Click="OnCloseClick"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                    Foreground="{StaticResource MutedBrush}" FontSize="10" Padding="8,2"
                    VerticalAlignment="Top" ToolTip="Descartar"/>
            <TextBlock DockPanel.Dock="Left" x:Name="IconText" FontFamily="Segoe MDL2 Assets"
                       FontSize="16" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Top" Margin="0,2,12,0"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}"
                           FontSize="12.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="MessageText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                <!-- Foto de la automatización (p. ej. el snapshot de la cámara
                     del sector): el operador ve QUÉ pasó, no solo que pasó. -->
                <Image x:Name="AlertImage" Margin="0,8,0,0" MaxWidth="400" MaxHeight="230"
                       Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
                <!-- Acuse de recibo: mientras el aviso lo exija, la notificación
                     NO se cierra sola; alguien tiene que darse por enterado y
                     eso queda registrado en el servidor. -->
                <StackPanel x:Name="AckPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button x:Name="AckButton" Content="Enterado" Click="OnAcknowledge"
                            Padding="14,5" Cursor="Hand" FontSize="11.5"/>
                    <TextBlock x:Name="AckHint" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="Queda registrado quién confirma y a qué hora"/>
                </StackPanel>
                <TextBlock x:Name="PathText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5">
                    <Hyperlink x:Name="PathLink" Click="OnOpenLocation" TextDecorations="None"
                               Foreground="{StaticResource AccentBrush}"
                               ToolTip="Abrir la ubicación del archivo en el Explorador">
                        <Run x:Name="PathRun"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
