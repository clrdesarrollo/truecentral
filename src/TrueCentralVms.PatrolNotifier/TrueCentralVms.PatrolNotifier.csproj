<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aviso en pantalla de la base de descarga de rondas. El servicio
    truecentral-patrol corre sin escritorio y no puede mostrar ventanas: esta
    app se inicia con la sesión del usuario del PC de la guardia (tecla Run de
    HKLM), escucha el progreso por un named pipe local y muestra «No desconecte
    el bastón» con el avance de la descarga. No se conecta al servidor.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>truecentral-patrol-aviso</AssemblyName>
    <RootNamespace>TrueCentralVms.PatrolNotifier</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
  </ItemGroup>

</Project>
