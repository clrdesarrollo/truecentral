<Window x:Class="TrueCentralVms.Watchdog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLR TrueCentral VMS — Watchdog del servidor"
        Style="{StaticResource DarkWindow}"
        Width="620" Height="660"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold">
                    CLR <Run Foreground="{StaticResource AccentBrush}">TrueCentral</Run> VMS
                </TextBlock>
                <TextBlock Foreground="{StaticResource MutedBrush}">Watchdog del servidor</TextBlock>
            </StackPanel>
            <TextBlock x:Name="SelfVersionText" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Grid>

        <!-- Estado general -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="GlobalDot" Width="14" Height="14" Fill="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="GlobalText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="Verificando..."/>
                </StackPanel>
                <TextBlock x:Name="ServerVersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    x:Name="SvcCard" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,5,0"
                    ToolTip="Estado del servicio de Windows CLRTrueCentralVMS">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="SvcDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Servicio" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="SvcText" FontWeight="SemiBold" Text="—"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    x:Name="ApiCard" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="5,0"
                    ToolTip="Respuesta de la API y el panel web (/api/health)">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="ApiDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="API / Panel web" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="ApiText" FontWeight="SemiBold" Text="—"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    x:Name="DbCard" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="5,0,0,0"
                    ToolTip="PostgreSQL embebido (127.0.0.1)">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="DbDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Base de datos" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="DbText" FontWeight="SemiBold" Text="—"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Acciones -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="OnStartClick"
                        MinWidth="170" IsEnabled="False">▶  Iniciar servicio</Button>
                <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Click="OnStopClick"
                        MinWidth="170" Margin="10,0,0,0" IsEnabled="False">⏹  Detener servicio</Button>
            </StackPanel>
            <Button x:Name="OpenPanelButton" HorizontalAlignment="Right" Click="OnOpenPanelClick"
                    ToolTip="Abre el panel web de administración en el navegador">Abrir panel web</Button>
        </Grid>

        <!-- Actividad -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Actividad" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" Margin="10,7,10,5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,7">
                    <StackPanel x:Name="ActivityPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pie: solo la hora del último sondeo. El servicio, la URL y el puerto
             de la base viven en los tooltips de cada indicador, que es donde se
             los busca cuando hacen falta. -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <TextBlock x:Name="FooterRight" HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Última verificación: —"/>
        </Grid>
    </Grid>
</Window>
