<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrueCentralVms.AlarmScreen.ViewModels"
        xmlns:views="using:TrueCentralVms.AlarmScreen.Views"
        x:Class="TrueCentralVms.AlarmScreen.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="TrueCentral · Pantalla de alarma"
        Width="1280" Height="800"
        Background="#12181D">

  <Grid RowDefinitions="Auto,*">

    <!-- Encabezado: quién soy, si estoy vivo y cuántas quedan sin ver -->
    <Border Grid.Row="0" Background="#1B2430" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding ScreenName}" FontSize="24" FontWeight="Bold" Foreground="#ECEFF1" />
            <TextBlock Text="{Binding SiteName}" FontSize="15" Foreground="#78909C" VerticalAlignment="Bottom"
                       Margin="0,0,0,3" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{Binding IsOnline, Converter={x:Static vm:StatusConverters.OnlineBrush}}" />
            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#90A4AE" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="#B71C1C" CornerRadius="20" Padding="18,8" Margin="0,0,16,0"
                VerticalAlignment="Center"
                IsVisible="{Binding PendingCount, Converter={x:Static vm:StatusConverters.IsPositive}}">
          <TextBlock Text="{Binding PendingCount, Converter={x:Static vm:StatusConverters.PendingText}}"
                     Foreground="White" FontWeight="Bold" FontSize="16" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{Binding Clock}" FontSize="28" FontWeight="Light" Foreground="#B0BEC5"
                     VerticalAlignment="Center" />
          <Button Classes="ghost" Content="TODAS VISTAS" Command="{Binding AcknowledgeAllCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Cuerpo, monitor apaisado: lista a la izquierda, detalle a la derecha. La lista lleva un
         ancho fijo y todo lo que sobra se lo queda el detalle: es lo que el guardia mira de lejos
         y lo que lleva la foto. En proporción, la lista crecería en los monitores grandes justo
         donde menos falta hace.
         El número está puesto contra los 800x600 de las pantallas de caseta, que es el caso más
         apretado: ahí deja 336 para la lista y 464 para el detalle. Con los 420 que había antes
         la lista se llevaba más de la mitad de la pantalla. No bajar mucho de 336: la fila de
         hora, prioridad y «SIN VER» de cada tarjeta necesita unos 250 y no sabe partirse en dos
         renglones. -->
    <Grid Grid.Row="1" ColumnDefinitions="336,*" IsVisible="{Binding !IsVerticalLayout}">
      <views:AlarmListView Grid.Column="0" />
      <views:AlarmDetailView Grid.Column="1" Margin="10,10,20,20" />
    </Grid>

    <!-- Cuerpo, monitor en pie: las mismas dos piezas, apiladas. El detalle va arriba y se lleva
         más espacio: es lo que el guardia mira de lejos y lo que lleva la foto. -->
    <Grid Grid.Row="1" RowDefinitions="3*,2*" IsVisible="{Binding IsVerticalLayout}">
      <views:AlarmDetailView Grid.Row="0" Margin="10,10,10,0" />
      <views:AlarmListView Grid.Row="1" />
    </Grid>

    <!-- Foto a pantalla completa. Doble clic —o Escape— para volver. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#F2000000"
            IsVisible="{Binding IsPhotoFullScreen}"
            DoubleTapped="OnFullScreenPhotoDoubleTapped" Cursor="Hand">
      <Grid RowDefinitions="Auto,*" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Selected.Title}" FontSize="22" FontWeight="SemiBold"
                     Foreground="#ECEFF1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="60,0,0,0"
                     HorizontalAlignment="Center" />

          <!-- Arriba a la derecha, donde se busca por costumbre. Grande a propósito: es la única
               salida con el dedo, y el doble toque que había antes no era fiable en táctil. -->
          <Button Grid.Column="1" Content="✕" VerticalAlignment="Top"
                  MinWidth="64" MinHeight="64" FontSize="30"
                  Background="#33FFFFFF" Foreground="#ECEFF1" CornerRadius="10"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ClosePhotoCommand}" />
        </Grid>
        <Image Grid.Row="1" Source="{Binding Selected.Photo}" Stretch="Uniform" Margin="0,12" />
      </Grid>
    </Border>

    <!-- Aviso de alarma nueva. Ocupa la pantalla y va en rojo a propósito: es lo único que tiene
         que mirar el guardia en ese momento. Es uno solo — si entra otra antes de cerrarlo, se
         reemplaza el contenido en vez de apilar avisos, o habría que cerrar dos y el segundo se
         cerraría sin haberlo leído. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#F04A0E0E" IsVisible="{Binding ShowAlarmPopup}">
      <Border Margin="26" CornerRadius="14" BorderThickness="3" BorderBrush="#EF5350"
              Background="#2A1113">
        <Grid ColumnDefinitions="*,*" DataContext="{Binding PopupAlarm}" x:DataType="vm:AlarmCardViewModel">

          <!-- Mitad izquierda: la foto, que es lo que se lee de lejos -->
          <Border Grid.Column="0" Margin="18" Background="#160A0B" CornerRadius="10" ClipToBounds="True">
            <Panel>
              <TextBlock Text="Esta alarma no trae imagen"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="16" Foreground="#8D6E63"
                         IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNull}}" />
              <Image Source="{Binding Photo}" Stretch="Uniform" />
            </Panel>
          </Border>

          <!-- Mitad derecha: qué pasó y el único botón -->
          <Grid Grid.Column="1" Margin="18" RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="12">
              <Border Background="{Binding PriorityBrush}" CornerRadius="4" Padding="14,5"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding PriorityText}" Foreground="White" FontWeight="Bold" FontSize="15" />
              </Border>
              <TextBlock Text="AVISO NUEVO" FontSize="14" Foreground="#EF9A9A" FontWeight="Bold" />
              <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding SourceName}" FontSize="20" Foreground="#E0B4B4" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" FontSize="17" Foreground="#E0B4B4" TextWrapping="Wrap"
                         IsVisible="{Binding HasMessage}" />
              <!-- Las consignas de la ficha del recurso: qué tiene que hacer el guardia -->
              <Border Background="#3A1A1C" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="8"
                      Padding="14,10" IsVisible="{Binding HasInstructions}">
                <StackPanel Spacing="4">
                  <TextBlock Text="QUÉ HACER" FontSize="12" FontWeight="Bold" Foreground="#EF9A9A" />
                  <TextBlock Text="{Binding Instructions}" FontSize="17" Foreground="#FFFFFF" TextWrapping="Wrap"
                             MaxLines="6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <TextBlock Text="{Binding DateText}" FontSize="15" Foreground="#BCAAAA" />
                <TextBlock Text="{Binding OriginText}" FontSize="15" Foreground="#BCAAAA" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Row="1" Classes="primary" HorizontalAlignment="Stretch" FontSize="22"
                    Content="MARCAR COMO VISTA"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AcknowledgePopupCommand}" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- Emparejamiento: la Pi muestra el código y el administrador lo aprueba -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#DD0E1418" IsVisible="{Binding IsPairing}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
        <TextBlock Text="EMPAREJAMIENTO" FontSize="16" Foreground="#90A4AE" HorizontalAlignment="Center" />
        <TextBlock Text="Apruebe este código en TrueCentral → Pantallas de alarma" FontSize="22" Foreground="#ECEFF1"
                   HorizontalAlignment="Center" />
        <Border Background="#1976D2" CornerRadius="12" Padding="60,24" HorizontalAlignment="Center">
          <TextBlock Text="{Binding PairingCode}" FontSize="82" FontWeight="Bold" Foreground="White"
                     LetterSpacing="12" />
        </Border>
        <TextBlock Text="{Binding PairingFingerprint, StringFormat=Huella del servidor: {0}}" FontSize="18"
                   Foreground="#ECEFF1" FontFamily="monospace" HorizontalAlignment="Center" />
        <TextBlock Text="El administrador debe ver la misma huella en TrueCentral antes de aprobar." FontSize="14"
                   Foreground="#90A4AE" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#90A4AE" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Configuración manual: el broadcast no cruza VLANs -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#DD0E1418" IsVisible="{Binding ShowSetup}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="560">
        <TextBlock Text="{Binding SetupTitle}" FontSize="28" FontWeight="Bold" Foreground="#ECEFF1"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="15" Foreground="#90A4AE"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Text="Si el servidor está en otra subred, escriba su dirección:"
                   FontSize="14" Foreground="#78909C" HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0" Text="{Binding ManualUrl}" Watermark="https://192.168.1.50" FontSize="18" />
          <Button Grid.Column="1" Classes="primary" Content="USAR" Command="{Binding UseManualUrlCommand}" />
        </Grid>
        <Button Content="OLVIDAR SERVIDOR Y VOLVER A EMPAREJAR" HorizontalAlignment="Center"
                IsVisible="{Binding CanForgetServer}" Command="{Binding ForgetServerCommand}" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
