<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    TrueCentral Rondas: base de descarga de bastones. Corre como servicio de
    Windows en el PC de la guardia, detecta el bastón puesto en su base (USB,
    CP210x), lo pone en hora, sube sus lecturas al servidor y lo vacía solo
    después de que el servidor confirma que las guardó. Diseño:
    docs/rondas/PLAN_MODULO_RONDAS.md.

      dotnet publish -c Release -r win-x64 (autocontenido)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrueCentralVms.PatrolAgent</RootNamespace>
    <AssemblyName>truecentral-patrol</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Patrol\TrueCentralVms.Drivers.Patrol.csproj" />
  </ItemGroup>

</Project>
