{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Web": {
    // Panel, API, hubs, clientes, pantallas y agentes: SOLO por HTTPS, con el
    // certificado del servidor (propio, o el que se cargue en Sistema →
    // Certificado HTTPS). Escucha en IPv4 e IPv6.
    "HttpsPort": 443,
    // HTTP sin cifrar: solo para equipos que no saben de TLS (paneles de alarma
    // que empujan eventos a /api/alarms/push, terminales ISUP que bajan fotos).
    // Las páginas se redirigen a HTTPS y el resto se rechaza. 0 = cerrado.
    "HttpPort": 80,
    // HTTP solo en 127.0.0.1/::1 para el propio equipo: autorización de
    // MediaMTX y la sonda de salud del instalador y del Watchdog.
    "InternalPort": 5099,
    // Política de contenido (CSP) del panel: el navegador solo corre el código
    // del propio servidor. "" = se aplica; "report-only" = solo avisa en la
    // consola del navegador (para diagnosticar una página que dejó de andar);
    // "off" = sin CSP. Ver WebSecurityHeaders.
    "ContentSecurityPolicy": ""
  },
  "Database": {
    // PostgreSQL embebido: PRIVADO de este sistema. Escucha solo en 127.0.0.1,
    // con contraseña propia generada, y NO usa el 5432 de PostgreSQL para no
    // chocar ni confundirse con una instalación del equipo (ni con el 25480
    // del producto videowall). Si el clúster ya existe manda el puerto de SU
    // postgresql.conf (este valor solo se aplica al crearlo). PgBinDir vacío =
    // autodetectar tools\postgres\pgsql\bin.
    "PgPort": 25490,
    "PgDataDir": "pgdata",
    "PgBinDir": ""
  },
  "Security": {
    // Caducidad de contraseñas en días. 0 = deshabilitada. Con un valor > 0,
    // al vencer la clave el login exige cambiarla (aplicando la política de
    // fortaleza y el historial: ninguna clave anterior se puede reutilizar).
    "PasswordMaxAgeDays": 0
  },
  "Isup": {
    // Servicio ISUP propio (TrueCentralVms.IsupHost.exe, lo lanza y vigila el
    // servidor): los equipos Hikvision detrás de NAT, 4G o MPLS se conectan
    // ellos al servidor con su ID y su clave ISUP (paneles AX PRO, terminales
    // de acceso, cámaras/DVR/NVR, parlantes y frentes de citofonía).
    "Enabled": true,
    // IP o nombre con que llegan a este servidor los equipos de FUERA de sus
    // redes (se les anuncia al registrarse para las alarmas, el video y la voz),
    // y la de las fotos de los eventos y de los rostros. Los equipos que están
    // en una de las redes del servidor reciben siempre la IP de su misma red.
    // Vacío = a cada equipo, la IP de este servidor por la que llegó, y las
    // fotos por la IP de salida a internet. Con dos redes, fije una IP que
    // alcancen todos los equipos; detrás de NAT, la IP pública o el nombre DNS.
    "PublicAddress": "",
    // Registro (TCP y UDP): 7660 es el de fábrica de ISUP; 7661 es donde se
    // registraban los paneles en la receptora de Hikvision que se usaba antes.
    "RegistrationPorts": [ 7660, 7661 ],
    "AlarmPort": 7662,           // alarmas ISUP 5.0 (MQTT)
    // ISUP 2.0/4.0 se registra SIN probar la clave (con el ID basta para suplantar
    // a un equipo): apagado por omisión. Se enciende desde Sistema → Conexión ISUP
    // confirmando el riesgo (ese ajuste guardado manda sobre este valor).
    "AllowLegacy": false,
    "LegacyAlarmPort": 7663,     // alarmas ISUP 2.0/4.0 (TCP y UDP), solo con AllowLegacy; 0 = no se escucha
    "StreamPort": 7664,          // video en vivo
    "PlaybackPort": 7665,        // reproducción de grabaciones
    "VoicePort": 7666,           // voz (parlantes y citofonía)
    "PictureServerPort": 7667,   // fotos de los eventos; 0 = apagado
    "CommandTimeoutMs": 15000,   // espera de cada orden (los equipos por 4G tardan)
    // API interna servidor ↔ servicio ISUP (solo 127.0.0.1).
    "ApiPort": 7699,
    // Base de las URL que el servidor publica para que los equipos descarguen
    // archivos (fotos de rostros). Vacío = http://{PublicAddress}:{Web:HttpPort}.
    "DownloadBaseUrl": ""
  },
  "Hikvision": {
    // Directorio para los logs internos de HCNetSDK (vacío = deshabilitado).
    "SdkLogDirectory": ""
  },
  "Anpr": {
    // Módulo Reconocimiento de patentes. Las fotos de cada lectura se guardan
    // en disco (la base solo lleva la ruta): vacío = junto al directorio de
    // datos de PostgreSQL, para que viajen con él en respaldos y migraciones.
    "ImageDirectory": "",
    // Purga del historial: 0 en cualquiera de los dos = ese límite no aplica.
    "RetentionDays": 90,
    "MaxEvents": 200000
  },
  "Speakers": {
    // Ganancia de la voz del operador hacia los parlantes IP (1 = sin cambio, 2 = +6 dB).
    // Los micrófonos de PC entregan poco nivel; el recorte se limita a picos.
    "TalkGain": 2.0
  },
  "Alarms": {
    // Paneles de alarma: cada cuántos segundos se relee el estado de áreas y
    // zonas (además de la relectura inmediata ante cada evento del panel).
    "PollSeconds": 30,
    // Sondeo rápido: solo para los paneles vigilados por una automatización
    // con condición sostenida ("el sensor sigue interrumpido"). Con el sondeo
    // normal una interrupción de pocos segundos ocurriría entera entre dos
    // lecturas. Sin automatizaciones de ese tipo, nadie paga este costo.
    "FastPollSeconds": 2,
    // Purga del historial de eventos: 0 = ese límite no aplica.
    "RetentionDays": 365,
    "MaxEvents": 500000,
    // Centro receptor de alarmas (SIA DC-09 por TCP: ADM-CID / SIA-DCS). En el
    // panel se configura como "Alarm Receiving Center" apuntando a este puerto;
    // se aceptan reportes solo desde la dirección de un panel habilitado.
    // ZoneNumbersStartAt: número con el que el panel reporta su primera zona
    // (Hikvision: 1), para convertirlo al identificador de su API (parte en 0).
    "Receiver": {
      "Enabled": true,
      "Port": 5091,
      "ZoneNumbersStartAt": 1
    }
  },
  "Cerco": {
    // Paneles de cerco eléctrico (ESP8266 con firmware CLRobotics). A diferencia
    // de los paneles de alarma, el servidor NO se conecta al equipo: el panel se
    // conecta AQUÍ por WebSocket y se autentica con su PSK (modelo tipo ISUP).
    "Receiver": {
      // Receptor WebSocket en PUERTO PROPIO (aparte de la API :5090). Enabled
      // false lo apaga sin borrar nada. El firewall del servidor debe permitir
      // este puerto desde la red de los paneles.
      "Enabled": true,
      "Port": 5092,
      // Cada cuántos segundos pide el panel que reporte su estado (el equipo
      // igual reporta ante cualquier cambio, en el acto).
      "ReportIntervalSeconds": 15,
      // URL WebSocket que se sugiere al provisionar un panel. Vacío = se arma
      // con el host de la petición y el puerto de arriba (ws://host:5092/panel).
      // Con NAT/DNS o TLS por proxy, fijar aquí, p. ej. "wss://vms.miempresa.cl/cerco".
      "PublicUrl": "",
      // true = rechazar estado/lista RF sin firma de TODOS los paneles. Con false, se
      // exige solo a los que la anuncian (firmware 1.5.0+). Activar cuando todos los
      // paneles tengan 1.5.0 o superior.
      "RequireSignedState": false
    },
    "Firmware": {
      // Servidor de descarga para la actualización de firmware (OTA) de los paneles,
      // en PUERTO PROPIO (no la API :5090). Solo sirve imágenes publicadas con un
      // token de un uso (10 min). El firewall debe permitir este puerto desde la red
      // de los paneles (el instalador lo abre).
      "Enabled": true,
      "Port": 5093,
      // IP o nombre con que el panel llega a este servidor. Vacío = la IP local de la
      // conexión WebSocket del panel (la que él ya usa). Fijar solo con NAT.
      "PublicHost": ""
    }
  },
  "Workflows": {
    // Automatizaciones: "cuando pase ESTO, hacer ESTO OTRO". Enabled false
    // deja de disparar sin borrar nada. MaxConcurrentRuns limita cuántas
    // ejecuciones corren a la vez (correos, FTP, parlantes); ActionTimeout es
    // el tope por acción, para que un servicio que no responde no deje colgada
    // la ejecución. Las fotos que capturan las acciones se guardan junto al
    // directorio de datos (vacío) o donde diga FileDirectory, y se purgan con
    // el historial. 0 en RetentionDays/MaxRuns = ese límite no aplica.
    "Enabled": true,
    "MaxConcurrentRuns": 4,
    "ActionTimeoutSeconds": 120,
    // Condición sostenida ("el sensor sigue interrumpido N segundos"): pausa
    // máxima que se tolera dentro de la ventana. Los detectores de movimiento
    // no informan la interrupción de corrido, sino pulsos con pausas de uno o
    // dos segundos; sin esta tolerancia solo servirían los contactos de puerta.
    "SustainedGapSeconds": 3,
    "FileDirectory": "",
    "RetentionDays": 90,
    "MaxRuns": 50000
  },
  "Supervisor": {
    // Watchdog de servicios: cada cuántos segundos se comprueba la salud de
    // PostgreSQL, MediaMTX y los subsistemas internos. Un servicio caído se
    // reinicia solo con esperas crecientes (5, 10, 20, 40, 60 s) hasta agotar
    // MaxRestartAttempts dentro de RestartWindowMinutes; tras ese tiempo
    // estable el contador vuelve a cero. InitialDelaySeconds da margen al
    // arranque antes de juzgar a nadie.
    "CheckSeconds": 10,
    "MaxRestartAttempts": 5,
    "RestartWindowMinutes": 10,
    "InitialDelaySeconds": 20
  },
  "Audit": {
    // Bitácora de auditoría (ISO 27001). Retención en días: los eventos más
    // antiguos se purgan automáticamente (y la purga queda auditada).
    // 0 = conservar todo para siempre.
    "RetentionDays": 0
  },
  "Licensing": {
    // Servidor central de licencias de CLRobotics (API de productos) y la
    // API key del producto "truecentral" creada en su backoffice. Con ambos
    // vacíos solo funciona la activación sin conexión (solicitud .req +
    // archivo .lic). TrialDays: período de prueba incorporado desde el primer
    // arranque sin licencia (0 = sin prueba). HeartbeatCheckMinutes: cada
    // cuánto se revisa si toca revalidar en línea (el intervalo real de
    // revalidación y la gracia vienen firmados dentro de la licencia).
    // PublicKey solo se respeta en compilaciones de desarrollo (Debug).
    // Siempre el servidor oficial (también en desarrollo); la ApiKey no va en
    // git: appsettings.Local.json o el instalador la ponen.
    "ServerUrl": "https://bouncer.clrobotics.cl",
    "ApiKey": "",
    "TrialDays": 30,
    "HeartbeatCheckMinutes": 60,
    "PublicKey": ""
  },
  "Streaming": {
    // Media server embebido (MediaMTX). RTSP hacia los clientes solo por TCP;
    // la API de control queda amarrada a 127.0.0.1.
    "RtspPort": 8654,
    "ApiPort": 9911,
    // Host que ven los clientes en las URL RTSP. Vacío = el host con el que
    // el cliente llamó a la API. Útil con NAT/DNS: ej. "vms.miempresa.cl".
    // También se anuncia como candidato WebRTC a los navegadores.
    "PublicHost": "",
    // Vista en vivo del panel web (WebRTC). La señalización de MediaMTX
    // escucha SOLO en 127.0.0.1 (este servidor la intermedia en
    // /api/streams/webrtc); el navegador recibe el video directo por el
    // puerto ICE, UDP y TCP (el instalador lo abre en el firewall).
    // WebRtcIcePort = 0 deshabilita la vista en vivo web.
    "WebRtcPort": 9914,
    "WebRtcIcePort": 8660,
    // IP o nombres extra que se anuncian a los navegadores (NAT, varias
    // redes): lista JSON o texto separado por comas.
    "WebRtcAdditionalHosts": ""
  }
}
