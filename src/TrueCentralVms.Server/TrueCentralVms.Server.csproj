<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Adam\TrueCentralVms.Drivers.Adam.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Dahua\TrueCentralVms.Drivers.Dahua.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Hikvision\TrueCentralVms.Drivers.Hikvision.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Onvif\TrueCentralVms.Drivers.Onvif.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.ZkTeco\TrueCentralVms.Drivers.ZkTeco.csproj" />
    <!-- Servicio ISUP interno: un ejecutable aparte que el servidor lanza y vigila. Se referencia para que quede junto al
         servidor (con el SDK ISUP en isup\); el instalador lo vuelve a publicar autocontenido en la misma carpeta. -->
    <ProjectReference Include="..\TrueCentralVms.IsupHost\TrueCentralVms.IsupHost.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Patrol\TrueCentralVms.Drivers.Patrol.csproj" />
  </ItemGroup>

  <!-- DLLs nativas de los SDK: se copian junto al ejecutable. Hikvision
       incluye la subcarpeta HCNetSDKCom que el SDK carga en runtime; Dahua
       lleva dhnetsdk.dll y sus dependencias. La carpeta lib\ de HCNetSDK trae
       además su programa de demostración (ClientDemoEn.exe y ClientDemoDll\):
       no es parte del servidor y no se distribuye. -->
  <ItemGroup>
    <None Include="..\..\native\hikvision\**\*" Exclude="..\..\native\hikvision\ClientDemoEn.exe;..\..\native\hikvision\ClientDemoDll\**" CopyToOutputDirectory="PreserveNewest" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\native\dahua\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- SDK de SADP (Hikvision): cambio de IP desde la búsqueda. Lleva OpenSSL 3, distinta de la 1.1 de HCNetSDK. -->
    <None Include="..\..\native\hikvision-sadp\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- SDK del lector USB de huellas (el mismo del Complemento): el servidor solo usa
         su comparación de plantillas, para no enrolar dos veces la misma huella. -->
    <None Include="..\..\native\hikvision-fp\*.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Automatizaciones: correo saliente (MailKit soporta STARTTLS y TLS
         implícito; SmtpClient de .NET no habla el 465 de la mayoría de los
         proveedores) y subida a FTP/FTPS. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <!-- Licenciamiento: verificación Ed25519 del archivo .lic firmado por el
         servidor central de licencias (.NET no trae Ed25519 nativo). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- MimeKit (MailKit) y PDFsharp arrastran System.Security.Cryptography.Pkcs
         10.0.0, vulnerable (CVE-2026-84008, denegación de servicio; corregida en
         10.0.13). Se fija la versión corregida hasta que ellos la suban. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Los SDK de Hikvision/Dahua son nativos de 64 bits: el proceso debe ser x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- El host ISUP se referencia como ejecutable dependiente del framework; en la suite se publica autocontenido aparte
         (build-installers.ps1), así que no hace falta que coincida aquí. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

</Project>
