<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TrueCentralVms.Core\TrueCentralVms.Core.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Dahua\TrueCentralVms.Drivers.Dahua.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Hikvision\TrueCentralVms.Drivers.Hikvision.csproj" />
    <ProjectReference Include="..\TrueCentralVms.Drivers.Onvif\TrueCentralVms.Drivers.Onvif.csproj" />
  </ItemGroup>

  <!-- DLLs nativas de los SDK: se copian junto al ejecutable. Hikvision
       incluye la subcarpeta HCNetSDKCom que el SDK carga en runtime; Dahua
       lleva dhnetsdk.dll y sus dependencias. -->
  <ItemGroup>
    <None Include="..\..\native\hikvision\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\native\dahua\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Los SDK de Hikvision/Dahua son nativos de 64 bits: el proceso debe ser x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
