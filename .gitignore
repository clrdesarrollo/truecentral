# Compilación
bin/
obj/
/dist/
.vs/
*.user

# ---------------------------------------------------------------------------
# Binarios que NO viven en git (cientos de MB, redistribuibles de terceros).
# Se reconstruyen con: build\setup-binaries.ps1
# ---------------------------------------------------------------------------
# SDKs de fábrica tal como los entrega el fabricante
/Resources/
# DLLs nativas que el servidor carga en runtime (derivadas de Resources\)
/native/
# PostgreSQL portable, MediaMTX y FFmpeg
/tools/

# ---------------------------------------------------------------------------
# Datos y secretos de runtime — NUNCA versionar
# ---------------------------------------------------------------------------
# Clúster PostgreSQL embebido: incluye tcvms-pg.secret (clave del superusuario)
# y tcvms-data.key (llave AES que descifra las contraseñas de los dispositivos)
/pgdata/
src/TrueCentralVms.Server/pgdata/
# Estado local del licenciamiento (license.lic + state.json), junto a pgdata
/license/
src/TrueCentralVms.Server/license/
*.secret
*.key
admin-initial.txt
# Configuración generada de MediaMTX: contiene las credenciales de los equipos
# embebidas en las URL RTSP de origen
mediamtx.runtime.yml
# Ajustes por instalación (puertos, rutas)
appsettings.Local.json
# ...menos la plantilla que el instalador copia en cada equipo.
!installer/config/appsettings.Local.json
# Fotos de los reconocimientos de patentes (las guarda el servidor en runtime;
# en la base solo queda su ruta)
/anpr/
src/TrueCentralVms.Server/anpr/
# Fotos y sonidos de las automatizaciones (datos de runtime; la base guarda solo rutas)
/workflows/
src/TrueCentralVms.Server/workflows/
# Salida del servidor cuando se lanza redirigiendo la consola
src/TrueCentralVms.Server/*.log
# Publicacion intermedia de los instaladores (installer/build-installers.ps1)
build/publish/
